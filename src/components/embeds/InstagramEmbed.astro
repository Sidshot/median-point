---
interface Props {
  url: string;
}

const { url } = Astro.props;
const cleanUrl = url.replace(/\?.*$/, '').replace(/\/$/, '');
---

<div class="social-embed instagram-embed not-prose">
  <blockquote
    class="instagram-media"
    data-instgrm-captioned
    data-instgrm-permalink={cleanUrl + '/?utm_source=ig_embed'}
    data-instgrm-version="14">
    <div class="ig-loading-placeholder">
      <a href={cleanUrl} target="_blank" rel="noopener noreferrer">
        View this post on Instagram
      </a>
    </div>
  </blockquote>
</div>

<script is:inline>
(function () {
  if (!document.querySelector('script[src*="instagram.com/embed.js"]')) {
    var s = document.createElement('script');
    s.src = 'https://www.instagram.com/embed.js';
    s.async = true;
    document.head.appendChild(s);
  } else if (window.instgrm) {
    window.instgrm.Embeds.process();
  }
})();
</script>

<style is:global>
  .ig-loading-placeholder {
    padding: 16px;
    text-align: center;
  }
  .ig-loading-placeholder a {
    color: #3897f0;
    text-decoration: none;
  }
  .instagram-media {
    background: #fafafa !important;
    border: 0 !important;
    border-radius: 12px !important;
    box-shadow: 0 0 1px 0 rgba(0,0,0,0.5), 0 1px 10px 0 rgba(0,0,0,0.15) !important;
    margin: 2rem auto !important;
    max-width: 540px !important;
    min-width: 326px !important;
    padding: 0 !important;
    width: calc(100% - 2px) !important;
  }
  .dark .instagram-media {
    background: #1a1a1a !important;
    box-shadow: 0 0 1px 0 rgba(255,255,255,0.15), 0 1px 10px 0 rgba(0,0,0,0.4) !important;
  }
</style>
