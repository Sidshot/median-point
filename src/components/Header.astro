---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<div id="progress-container" class="fixed top-0 left-0 w-full h-[3px] z-50 bg-transparent pointer-events-none">
	<div id="progress-bar" class="h-full bg-brand dark:bg-brand-dark w-0 transition-[width] duration-150 ease-out"></div>
</div>

<header class="border-b border-gray-200 dark:border-gray-800 bg-bg/90 dark:bg-bg-dark/90 sticky top-0 z-40 backdrop-blur-lg" transition:persist>
	<nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
		<h2 class="font-sans font-black text-xl tracking-tight">
			<a href="/" class="flex items-center gap-2 text-base dark:text-base-dark hover:opacity-80 transition-opacity no-underline group">
				<div class="bg-gray-900 dark:bg-white text-white dark:text-gray-900 flex items-center justify-center w-8 h-8 rounded-lg font-bold text-sm shadow-md shadow-brand/20 group-hover:-translate-y-0.5 transition-transform duration-300">
				  <span class="tracking-tighter pl-0.5">MP</span><span class="w-1 h-1 bg-brand rounded-full ml-0.5 mt-2"></span>
				</div>
				{SITE_TITLE}
			</a>
		</h2>

		<!-- Desktop Nav Links -->
		<div class="hidden md:flex items-center space-x-6 font-sans text-sm font-medium">
			<HeaderLink href="/" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark">Home</HeaderLink>
			<HeaderLink href="/archive" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark">Archive</HeaderLink>
			<HeaderLink href="/about" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark">About</HeaderLink>
			<HeaderLink href="/contact" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark">Contact</HeaderLink>
			
			<!-- Search Link -->
			<a href="/search" class="text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors" aria-label="Search" title="Search">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
			</a>
			
			<!-- RSS Link -->
			<a href="/rss.xml" target="_blank" class="text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors" aria-label="RSS Feed" title="RSS Feed">
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/></svg>
			</a>

			<!-- Theme Toggle (Desktop) -->
			<button id="theme-toggle" type="button" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-sm p-2 focus:outline-none transition-colors" aria-label="Toggle dark mode">
				<svg id="theme-toggle-dark-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
				<svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
			</button>
		</div>

		<!-- Mobile Controls -->
		<div class="flex items-center gap-2 md:hidden">
			<button id="theme-toggle-mobile" type="button" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-sm p-2 focus:outline-none transition-colors" aria-label="Toggle dark mode">
				<svg id="theme-toggle-dark-icon-mobile" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
				<svg id="theme-toggle-light-icon-mobile" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
			</button>
			<button id="mobile-menu-btn" type="button" class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg p-2 transition-colors" aria-label="Open menu">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
		</div>
	</nav>

	<!-- Mobile Slide-in Menu -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-800 bg-bg dark:bg-bg-dark px-4 pb-4 animate-slide-down">
		<div class="flex flex-col space-y-1 pt-2 font-sans text-base font-medium">
			<a href="/" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Home</a>
			<a href="/archive" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Archive</a>
			<a href="/about" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">About</a>
			<a href="/contact" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Contact</a>
			<a href="/search" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">Search</a>
			<a href="/rss.xml" target="_blank" class="block py-3 px-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">RSS Feed</a>
		</div>
	</div>
</header>

<!-- Scroll to Top Button -->
<button id="scroll-top-btn" class="fixed bottom-6 right-6 z-50 bg-brand hover:bg-red-800 text-white w-11 h-11 rounded-full shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:-translate-y-1" aria-label="Scroll to top">
	<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path></svg>
</button>

<style>
	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-slide-down {
		animation: slideDown 0.2s ease-out;
	}
</style>

<script is:inline>
	function syncThemeIcons() {
		var isDark = document.documentElement.classList.contains('dark');
		['', '-mobile'].forEach(function(suffix) {
			var darkIcon = document.getElementById('theme-toggle-dark-icon' + suffix);
			var lightIcon = document.getElementById('theme-toggle-light-icon' + suffix);
			if (darkIcon && lightIcon) {
				if (isDark) {
					lightIcon.classList.remove('hidden');
					darkIcon.classList.add('hidden');
				} else {
					darkIcon.classList.remove('hidden');
					lightIcon.classList.add('hidden');
				}
			}
		});
	}

	function doToggleTheme() {
		if (document.documentElement.classList.contains('dark')) {
			document.documentElement.classList.remove('dark');
			localStorage.setItem('theme', 'light');
		} else {
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', 'dark');
		}
		syncThemeIcons();
	}

	function setupHeader() {
		syncThemeIcons();

		// Theme toggles — bind with onclick to avoid stacking listeners
		var toggleDesktop = document.getElementById('theme-toggle');
		if (toggleDesktop) toggleDesktop.onclick = doToggleTheme;
		var toggleMobile = document.getElementById('theme-toggle-mobile');
		if (toggleMobile) toggleMobile.onclick = doToggleTheme;

		// Mobile menu
		var menuBtn = document.getElementById('mobile-menu-btn');
		var menu = document.getElementById('mobile-menu');
		if (menuBtn) {
			menuBtn.onclick = function() {
				if (menu) menu.classList.toggle('hidden');
			};
		}

		// Scroll to top
		var scrollBtn = document.getElementById('scroll-top-btn');
		if (scrollBtn) {
			scrollBtn.onclick = function() {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			};
		}
	}

	// Scroll-driven effects (progress bar + scroll-to-top visibility)
	if (!window.__mpScrollBound) {
		window.__mpScrollBound = true;
		window.addEventListener('scroll', function() {
			var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
			var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
			var scrolled = height > 0 ? (winScroll / height) * 100 : 0;
			var bar = document.getElementById('progress-bar');
			if (bar) bar.style.width = scrolled + '%';

			var scrollBtn = document.getElementById('scroll-top-btn');
			if (scrollBtn) {
				if (winScroll > 400) {
					scrollBtn.classList.remove('opacity-0', 'pointer-events-none');
					scrollBtn.classList.add('opacity-100', 'pointer-events-auto');
				} else {
					scrollBtn.classList.add('opacity-0', 'pointer-events-none');
					scrollBtn.classList.remove('opacity-100', 'pointer-events-auto');
				}
			}
		});
	}

	// Run on initial load + after every view transition
	setupHeader();
	document.addEventListener('astro:page-load', setupHeader);
	document.addEventListener('astro:after-swap', syncThemeIcons);
</script>
