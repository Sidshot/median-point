---
---

<div class="right-sidebar-motif hidden lg:block fixed right-0 top-0 bottom-0 w-[260px] pointer-events-none z-[-1] overflow-hidden opacity-5 dark:opacity-10 text-gray-900 dark:text-gray-100">
	<!-- Gradient mask to fade out towards the left (article side) -->
	<div class="absolute inset-0 mask-fade-left">
		<svg 
			width="100%" 
			height="100%" 
			viewBox="0 0 200 1000" 
			preserveAspectRatio="xMaxYMin slice"
			xmlns="http://www.w3.org/2000/svg"
			class="stroke-current fill-transparent"
		>
			<defs>
				<!-- Basic geometric star/lattice pattern -->
				<pattern id="jaali-lattice" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
					<path d="M20,0 L40,20 L20,40 L0,20 Z" stroke-width="0.5" stroke="currentColor" opacity="0.6"/>
					<path d="M20,10 L30,20 L20,30 L10,20 Z" stroke-width="0.25" stroke="currentColor" opacity="0.4"/>
					<line x1="0" y1="20" x2="40" y2="20" stroke-width="0.25" stroke="currentColor" opacity="0.3"/>
					<line x1="20" y1="0" x2="20" y2="40" stroke-width="0.25" stroke="currentColor" opacity="0.3"/>
					<circle cx="20" cy="20" r="2" fill="currentColor" opacity="0.5" stroke="none"/>
				</pattern>

				<!-- Medallion -->
				<g id="medallion">
					<circle cx="0" cy="0" r="30" stroke-width="0.5"/>
					<circle cx="0" cy="0" r="26" stroke-width="0.25"/>
					<path d="M0,-26 L8,-8 L26,0 L8,8 L0,26 L-8,8 L-26,0 L-8,-8 Z" stroke-width="0.5" fill="currentColor" opacity="0.1"/>
					<circle cx="0" cy="0" r="4" fill="currentColor" opacity="0.7" stroke="none"/>
				</g>
			</defs>

			<!-- Outer Border Frame -->
			<rect x="20" y="20" width="160" height="960" stroke-width="1"/>
			<rect x="24" y="24" width="152" height="952" stroke-width="0.5"/>
			<rect x="30" y="30" width="140" height="940" stroke-width="0.25"/>

			<!-- Main Architectural Arch -->
			<path d="M 30,250 
					 L 30,120 
					 C 30,80 60,60 100,40 
					 C 140,60 170,80 170,120 
					 L 170,250" 
				  stroke-width="1.5" fill="none"/>
			
			<path d="M 36,250 
					 L 36,125 
					 C 36,90 60,70 100,50 
					 C 140,70 164,90 164,125 
					 L 164,250" 
				  stroke-width="0.5" fill="none"/>

			<!-- Jaali Lattice Fill within the arch -->
			<path d="M 40,250 
					 L 40,130 
					 C 40,95 65,80 100,60 
					 C 135,80 160,95 160,130 
					 L 160,250 Z" 
				  fill="url(#jaali-lattice)" stroke="none"/>

			<!-- Top Medallion -->
			<use href="#medallion" x="100" y="100"/>
			
			<!-- Spaced vertical line to anchor the design downwards -->
			<line x1="100" y1="250" x2="100" y2="950" stroke-width="0.25" stroke-dasharray="4 4"/>
			
			<!-- Bottom Medallion -->
			<use href="#medallion" x="100" y="850"/>

			<!-- Bottom Arch (inverted) -->
			<path d="M 30,750 
					 L 30,880 
					 C 30,920 60,940 100,960 
					 C 140,940 170,920 170,880 
					 L 170,750" 
				  stroke-width="1.5" fill="none"/>
				  
			<path d="M 40,750 
					 L 40,870 
					 C 40,905 65,920 100,940 
					 C 135,920 160,905 160,870 
					 L 160,750 Z" 
				  fill="url(#jaali-lattice)" stroke="none"/>

		</svg>
	</div>
</div>

<style>
	/* CSS Masking to ensure the left side (towards article) fades out completely */
	.mask-fade-left {
		-webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.8) 40%, rgba(0,0,0,1) 100%);
		mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.8) 40%, rgba(0,0,0,1) 100%);
	}
</style>
