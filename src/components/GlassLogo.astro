---
/**
 * GlassLogo.astro
 * Premium glassmorphism applied directly to the TEXT (no background slab).
 */
---

<div class="glass-text-container">
	<h1 class="glass-text" data-text="MEDIAN POINT">
		MEDIAN POINT
	</h1>
</div>

<style>
	.glass-text-container {
		position: relative;
		display: inline-block;
		padding: 1rem 2rem;
		cursor: default;
	}

	.glass-text {
		position: relative;
		font-family: 'Inter', system-ui, sans-serif;
		font-weight: 900;
		font-size: 2.5rem;
		letter-spacing: 0.08em;
		margin: 0;
		line-height: 1.2;
		
		/* 1. The Glass Core: Semi-transparent fill letting the background show through slightly */
		color: transparent;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.8) 0%,
			rgba(147, 197, 253, 0.6) 30%,
			rgba(37, 99, 235, 0.9) 70%,
			rgba(30, 58, 138, 0.9) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;

		/* 2. The Glass Bevel/Rim: A crisp stroke around the text */
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.6);

		/* 3. The Depth & Shadow: Drop shadow applied to the text shape */
		filter: 
			drop-shadow(0px 8px 16px rgba(37, 99, 235, 0.25))
			drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.1));
			
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
	}

	/* Shimmering reflection sweeping across the text */
	.glass-text::before {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		color: transparent;
		background: linear-gradient(
			90deg,
			transparent 0%,
			transparent 40%,
			rgba(255, 255, 255, 0.8) 50%,
			transparent 60%,
			transparent 100%
		);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		animation: textShimmer 4s ease-in-out infinite;
		pointer-events: none;
	}

	.glass-text:hover {
		transform: translateY(-2px) scale(1.02);
		filter: 
			drop-shadow(0px 12px 24px rgba(37, 99, 235, 0.35))
			drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.15));
	}

	/* Dark Mode Adjustments */
	:global(.dark) .glass-text {
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.9) 0%,
			rgba(191, 219, 254, 0.7) 30%,
			rgba(96, 165, 250, 0.9) 70%,
			rgba(29, 78, 216, 0.9) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		
		-webkit-text-stroke: 1px rgba(147, 197, 253, 0.4);
		
		filter: 
			drop-shadow(0px 8px 16px rgba(59, 130, 246, 0.2))
			drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.3));
	}

	:global(.dark) .glass-text:hover {
		filter: 
			drop-shadow(0px 12px 24px rgba(59, 130, 246, 0.3))
			drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.4));
	}

	:global(.dark) .glass-text::before {
		background: linear-gradient(
			90deg,
			transparent 0%,
			transparent 40%,
			rgba(255, 255, 255, 0.6) 50%,
			transparent 60%,
			transparent 100%
		);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
	}

	@keyframes textShimmer {
		0% { background-position: 200% 0; }
		100% { background-position: -200% 0; }
	}

	/* Responsive sizing */
	@media (min-width: 768px) {
		.glass-text {
			font-size: 3.5rem;
			letter-spacing: 0.08em;
		}
	}

	@media (min-width: 1024px) {
		.glass-text {
			font-size: 4rem;
		}
	}
</style>
