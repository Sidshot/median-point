---
import BlockWrapper from './BlockWrapper.astro';
const { pros = [], cons = [], ...designProps } = Astro.props;
---
<BlockWrapper {...designProps} class={`pros-cons my-10 not-prose grid grid-cols-1 md:grid-cols-2 gap-6 ${designProps.class || ''}`}>
  <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-6 border border-green-100 dark:border-green-900/50">
    <h3 class="font-sans font-bold text-green-800 dark:text-green-400 mb-4 flex items-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
      Pros
    </h3>
    <ul class="space-y-3">
      {pros.map((pro: string) => <li class="flex text-green-900 dark:text-green-200 font-serif text-sm"><span class="mr-2">•</span>{pro}</li>)}
    </ul>
  </div>
  <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-6 border border-red-100 dark:border-red-900/50">
    <h3 class="font-sans font-bold text-red-800 dark:text-red-400 mb-4 flex items-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>
      Cons
    </h3>
    <ul class="space-y-3">
      {cons.map((con: string) => <li class="flex text-red-900 dark:text-red-200 font-serif text-sm"><span class="mr-2">•</span>{con}</li>)}
    </ul>
  </div>
</BlockWrapper>
