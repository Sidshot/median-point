---
import BlockWrapper from './BlockWrapper.astro';
const { pros = [], cons = [], ...designProps } = Astro.props;
---
<BlockWrapper {...designProps} class={`pros-cons my-12 not-prose grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 ${designProps.class || ''}`}>
  
  {/* PROS BOX */}
  <div class="bg-white dark:bg-[#1a1a1a] rounded-xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] border border-gray-100 dark:border-white/5 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-emerald-500/80"></div>
    <h3 class="font-sans font-bold text-gray-900 dark:text-gray-100 text-lg mb-6 flex items-center tracking-wide uppercase">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-emerald-50 dark:bg-emerald-500/10 mr-3">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      Advantages
    </h3>
    <ul class="space-y-4">
      {pros.map((pro: string) => (
        <li class="flex text-gray-700 dark:text-gray-300 font-serif text-base leading-relaxed">
          <span class="text-emerald-500 mr-3 mt-1 select-none">
             <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 16 16 12 12 8"></polyline><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          </span>
          <span>{pro}</span>
        </li>
      ))}
    </ul>
  </div>

  {/* CONS BOX */}
  <div class="bg-white dark:bg-[#1a1a1a] rounded-xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] border border-gray-100 dark:border-white/5 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-rose-500/80"></div>
    <h3 class="font-sans font-bold text-gray-900 dark:text-gray-100 text-lg mb-6 flex items-center tracking-wide uppercase">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-rose-50 dark:bg-rose-500/10 mr-3">
        <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </div>
      Disadvantages
    </h3>
    <ul class="space-y-4">
      {cons.map((con: string) => (
        <li class="flex text-gray-700 dark:text-gray-300 font-serif text-base leading-relaxed">
          <span class="text-rose-500 mr-3 mt-1 select-none">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          </span>
          <span>{con}</span>
        </li>
      ))}
    </ul>
  </div>

</BlockWrapper>
