---
<div class="drop-cap-wrapper">
  <slot />
</div>

<style>
  .drop-cap-wrapper > p:first-child::first-letter {
    float: left;
    font-size: 4.5em;
    line-height: 0.8;
    padding-right: 0.1em;
    padding-top: 0.05em;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-weight: 900;
    color: var(--color-brand, #B91C1C); /* Fallback to red */
  }
  
  :global(.dark) .drop-cap-wrapper > p:first-child::first-letter {
    color: var(--color-brand-dark, #F87171);
  }
</style>
