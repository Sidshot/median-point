---
import BlockWrapper from './BlockWrapper.astro';
const { questions = [], rawContent = '', ...designProps } = Astro.props;

let parsedQuestions = [...questions];

if (rawContent) {
  const lines = rawContent.split('\n').map((l: string) => l.trim()).filter((l: string) => l.length > 0);
  let currentQ: string | null = null;
  let currentA: string[] = [];

  for (const line of lines) {
    if (line.match(/^Q\s*:/i) || line.endsWith('?')) {
      if (currentQ) {
        parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
      }
      currentQ = line.replace(/^Q\s*:\s*/i, '');
      currentA = [];
    } else {
      currentA.push(line.replace(/^A\s*:\s*/i, ''));
    }
  }
  if (currentQ) {
    parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
  }
}
---
<BlockWrapper {...designProps} class={`faq-block my-16 not-prose ${designProps.class || ''}`} style="box-shadow: none;">
  <div class="bg-[#f8f9fa] dark:bg-[#111827] border border-gray-200 dark:border-gray-800 p-8 md:p-12 relative">
    <!-- Decorative top accent -->
    <div class="absolute top-0 left-0 w-full h-1.5 bg-brand dark:bg-brand-dark"></div>
    
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-sans font-black !text-black dark:!text-white m-0 tracking-tight">Frequently Asked Questions</h2>
    </div>
    
    <div class="border-t-[3px] border-black dark:border-white">
      {parsedQuestions.map((q: any) => (
        <details class="group border-b border-gray-300 dark:border-gray-700 [&_summary::-webkit-details-marker]:hidden overflow-hidden">
          <summary class="flex cursor-pointer items-start justify-between gap-6 py-6 font-sans font-bold !text-gray-900 dark:!text-white select-none hover:!text-brand dark:hover:!text-brand-dark transition-colors">
            <h3 class="text-xl md:text-2xl m-0 leading-tight tracking-tight">{q.question}</h3>
            <div class="shrink-0 transition-transform duration-300 group-open:-rotate-180 mt-1">
              <svg class="h-6 w-6 text-gray-400 dark:text-gray-500 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="pb-8 pt-2 !text-gray-800 dark:!text-gray-200 font-serif leading-relaxed text-lg md:text-xl pr-4 md:pr-12">
            {q.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</BlockWrapper>
