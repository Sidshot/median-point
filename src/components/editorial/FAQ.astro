---
import BlockWrapper from './BlockWrapper.astro';
const { questions = [], rawContent = '', ...designProps } = Astro.props;

let parsedQuestions = [...questions];

if (rawContent) {
  const lines = rawContent.split('\n').map((l: string) => l.trim()).filter((l: string) => l.length > 0);
  let currentQ: string | null = null;
  let currentA: string[] = [];

  for (const line of lines) {
    if (line.match(/^Q\s*:/i) || line.endsWith('?')) {
      if (currentQ) {
        parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
      }
      currentQ = line.replace(/^Q\s*:\s*/i, '');
      currentA = [];
    } else {
      currentA.push(line.replace(/^A\s*:\s*/i, ''));
    }
  }
  if (currentQ) {
    parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
  }
}
---
<BlockWrapper {...designProps} class={`faq-block my-10 not-prose ${designProps.class || ''}`}>
  <div class="border-t border-gray-200 dark:border-gray-800">
    {parsedQuestions.map((q: any) => (
      <details class="group border-b border-gray-200 dark:border-gray-800 [&_summary::-webkit-details-marker]:hidden overflow-hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 font-sans font-medium text-gray-900 dark:text-gray-100 select-none hover:text-brand dark:hover:text-brand-dark transition-colors">
          <h2 class="text-base md:text-lg m-0">{q.question}</h2>
          <div class="shrink-0 transition-transform duration-300 group-open:-rotate-180 text-gray-400 dark:text-gray-500">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>
        <div class="pb-5 pt-1 text-gray-600 dark:text-gray-400 font-serif leading-relaxed text-sm md:text-base pr-8">
          {q.answer}
        </div>
      </details>
    ))}
  </div>
</BlockWrapper>
