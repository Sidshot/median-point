---
import BlockWrapper from './BlockWrapper.astro';
const { questions = [], ...designProps } = Astro.props;
---
<BlockWrapper {...designProps} class={`faq-block my-10 not-prose ${designProps.class || ''}`}>
  <div class="space-y-6">
    {questions.map((q: any) => (
      <details class="group bg-white dark:bg-[#1a1a1a] rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] border border-transparent dark:border-white/5 transition-all duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] [&_summary::-webkit-details-marker]:hidden overflow-hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-sans font-semibold text-gray-900 dark:text-gray-100 select-none">
          <h2 class="text-lg md:text-xl m-0">{q.question}</h2>
          <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-gray-50 dark:bg-gray-800 shrink-0 group-open:bg-brand/10 dark:group-open:bg-brand-dark/20 transition-colors">
            <svg class="h-4 w-4 text-gray-500 dark:text-gray-400 group-open:text-brand dark:group-open:text-brand-dark transition-transform duration-300 group-open:-rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>
        <div class="px-6 pb-6 pt-2 text-gray-600 dark:text-gray-300 font-serif leading-relaxed text-base border-t border-gray-100 dark:border-gray-800/50 mx-6 mt-0">
          {q.answer}
        </div>
      </details>
    ))}
  </div>
</BlockWrapper>
