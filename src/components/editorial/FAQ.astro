---
const { questions = [], rawContent = '' } = Astro.props;

let parsedQuestions = [...questions];

if (rawContent) {
  const lines = rawContent.split('\n').map((l: string) => l.trim()).filter((l: string) => l.length > 0);
  let currentQ: string | null = null;
  let currentA: string[] = [];

  for (const line of lines) {
    if (line.match(/^Q\s*:/i) || line.endsWith('?')) {
      if (currentQ) {
        parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
      }
      currentQ = line.replace(/^Q\s*:\s*/i, '');
      currentA = [];
    } else {
      currentA.push(line.replace(/^A\s*:\s*/i, ''));
    }
  }
  if (currentQ) {
    parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
  }
}
---

<aside class="faq-drawer-container no-print not-prose">
  <!-- The floating button/tab on the left edge -->
  <button 
    class="faq-tab fixed left-0 top-1/2 -translate-y-1/2 z-40 bg-brand dark:bg-brand-dark text-white shadow-xl py-5 px-1.5 rounded-r-lg flex flex-col items-center justify-center gap-2 hover:pr-3 hover:bg-brand-dark transition-all"
    aria-label="Open FAQ"
  >
    <span class="font-sans font-black text-sm tracking-widest uppercase [writing-mode:vertical-lr] rotate-180">FAQ</span>
  </button>

  <!-- The sliding drawer & backdrop -->
  <div class="faq-modal fixed inset-0 z-50 pointer-events-none" aria-modal="true" role="dialog">
    <!-- Backdrop -->
    <div class="faq-backdrop absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>
    
    <!-- Drawer Panel -->
    <div class="faq-panel absolute top-0 left-0 h-full w-[85vw] max-w-[360px] bg-[#fdfdfd] dark:bg-[#0b1120] shadow-2xl transform -translate-x-full transition-transform duration-300 flex flex-col pointer-events-none border-r border-gray-200 dark:border-gray-800">
      
      <!-- Drawer Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-gray-800 shrink-0 bg-[#f9f9f9] dark:bg-[#111827]">
        <h2 class="font-sans font-black text-xl m-0 text-gray-900 dark:text-white uppercase tracking-tight">FAQ</h2>
        <button class="faq-close p-2 -mr-2 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors" aria-label="Close FAQ">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Drawer Content -->
      <div class="flex-grow overflow-y-auto overscroll-contain p-5 space-y-4">
        {parsedQuestions.map((q: any) => (
          <details class="group border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50 rounded-none [&_summary::-webkit-details-marker]:hidden overflow-hidden transition-all duration-300 hover:shadow-sm">
            <summary class="flex cursor-pointer items-start justify-between gap-4 p-4 font-sans font-bold text-sm text-gray-900 dark:text-gray-100 select-none hover:text-brand dark:hover:text-brand-dark transition-colors">
              <span class="leading-snug">{q.question}</span>
              <div class="shrink-0 transition-transform duration-300 group-open:-rotate-180 mt-0.5">
                <svg class="h-4 w-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <div class="px-4 pb-4 pt-0 text-gray-600 dark:text-gray-400 font-serif leading-relaxed text-xs">
              {q.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</aside>

<script>
  type FaqWindow = Window & {
    __mpFaqCleanup?: () => void;
    __mpFaqPageLoadBound?: boolean;
  };

  function initFaqDrawers() {
    const faqWindow = window as FaqWindow;
    faqWindow.__mpFaqCleanup?.();

    const cleanupHandlers: Array<() => void> = [];
    const containers = document.querySelectorAll<HTMLElement>('.faq-drawer-container');

    containers.forEach(container => {
      const tab = container.querySelector<HTMLButtonElement>('.faq-tab');
      const closeBtn = container.querySelector<HTMLButtonElement>('.faq-close');
      const modal = container.querySelector<HTMLElement>('.faq-modal');
      const backdrop = container.querySelector<HTMLElement>('.faq-backdrop');
      const panel = container.querySelector<HTMLElement>('.faq-panel');

      if (!tab || !modal || !backdrop || !panel) return;

      const modalEl = modal;
      const backdropEl = backdrop;
      const panelEl = panel;

      function openDrawer() {
        modalEl.classList.remove('pointer-events-none');
        backdropEl.classList.remove('pointer-events-none');
        panelEl.classList.remove('pointer-events-none');
        
        setTimeout(() => {
          backdropEl.classList.remove('opacity-0');
          panelEl.classList.remove('-translate-x-full');
        }, 10);
        
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        backdropEl.classList.add('opacity-0');
        panelEl.classList.add('-translate-x-full');
        
        setTimeout(() => {
          modalEl.classList.add('pointer-events-none');
          backdropEl.classList.add('pointer-events-none');
          panelEl.classList.add('pointer-events-none');
          document.body.style.overflow = '';
        }, 300);
      }

      tab.onclick = openDrawer;
      if (closeBtn) closeBtn.onclick = closeDrawer;
      backdropEl.onclick = closeDrawer;

      cleanupHandlers.push(() => {
        tab.onclick = null;
        if (closeBtn) closeBtn.onclick = null;
        backdropEl.onclick = null;
        document.body.style.overflow = '';
      });
    });

    faqWindow.__mpFaqCleanup = () => {
      cleanupHandlers.forEach(cleanup => cleanup());
    };
  }

  // Initialize on page load and after Astro view transitions
  const faqWindow = window as FaqWindow;
  if (!faqWindow.__mpFaqPageLoadBound) {
    document.addEventListener('astro:page-load', initFaqDrawers);
    faqWindow.__mpFaqPageLoadBound = true;
  }

  // Also run immediately in case the script executes after DOMContentLoaded
  initFaqDrawers();
</script>
