---
import BlockWrapper from './BlockWrapper.astro';
const { questions = [], rawContent = '', ...designProps } = Astro.props;

let parsedQuestions = [...questions];

if (rawContent) {
  const lines = rawContent.split('\n').map((l: string) => l.trim()).filter((l: string) => l.length > 0);
  let currentQ: string | null = null;
  let currentA: string[] = [];

  for (const line of lines) {
    if (line.match(/^Q\s*:/i) || line.endsWith('?')) {
      if (currentQ) {
        parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
      }
      currentQ = line.replace(/^Q\s*:\s*/i, '');
      currentA = [];
    } else {
      currentA.push(line.replace(/^A\s*:\s*/i, ''));
    }
  }
  if (currentQ) {
    parsedQuestions.push({ question: currentQ, answer: currentA.join(' ') });
  }
}
// Generate a unique ID for this FAQ block so multiple blocks on the same page don't conflict
const uniqueId = Math.random().toString(36).substring(2, 9);
---

<div class="faq-drawer-container no-print not-prose">
  <!-- The floating button/tab on the left edge -->
  <button 
    id={`faq-tab-${uniqueId}`}
    class="fixed left-0 top-1/2 -translate-y-1/2 z-40 bg-brand dark:bg-brand-dark text-white shadow-xl py-5 px-1.5 rounded-r-lg flex flex-col items-center justify-center gap-2 hover:pr-3 hover:bg-brand-dark transition-all"
    aria-label="Open FAQ"
  >
    <span class="font-sans font-black text-sm tracking-widest uppercase [writing-mode:vertical-lr] rotate-180">FAQ</span>
  </button>

  <!-- The sliding drawer & backdrop -->
  <div id={`faq-modal-${uniqueId}`} class="fixed inset-0 z-50 pointer-events-none" aria-modal="true" role="dialog">
    <!-- Backdrop -->
    <div id={`faq-backdrop-${uniqueId}`} class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>
    
    <!-- Drawer Panel -->
    <div id={`faq-panel-${uniqueId}`} class="absolute top-0 left-0 h-full w-[85vw] max-w-[360px] bg-[#fdfdfd] dark:bg-[#0b1120] shadow-2xl transform -translate-x-full transition-transform duration-300 flex flex-col pointer-events-none border-r border-gray-200 dark:border-gray-800">
      
      <!-- Drawer Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-gray-800 shrink-0 bg-[#f9f9f9] dark:bg-[#111827]">
        <h2 class="font-sans font-black text-xl m-0 text-gray-900 dark:text-white uppercase tracking-tight">FAQ</h2>
        <button id={`faq-close-${uniqueId}`} class="p-2 -mr-2 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors" aria-label="Close FAQ">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Drawer Content -->
      <div class="flex-grow overflow-y-auto overscroll-contain p-5 space-y-4">
        {parsedQuestions.map((q: any) => (
          <details class="group border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/50 rounded-none [&_summary::-webkit-details-marker]:hidden overflow-hidden transition-all duration-300 hover:shadow-sm">
            <summary class="flex cursor-pointer items-start justify-between gap-4 p-4 font-sans font-bold text-sm text-gray-900 dark:text-gray-100 select-none hover:text-brand dark:hover:text-brand-dark transition-colors">
              <span class="leading-snug">{q.question}</span>
              <div class="shrink-0 transition-transform duration-300 group-open:-rotate-180 mt-0.5">
                <svg class="h-4 w-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <div class="px-4 pb-4 pt-0 text-gray-600 dark:text-gray-400 font-serif leading-relaxed text-xs">
              {q.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ id: uniqueId }}>
  function setupFaqDrawer(uniqueId) {
    const tab = document.getElementById(`faq-tab-${uniqueId}`);
    const closeBtn = document.getElementById(`faq-close-${uniqueId}`);
    const modal = document.getElementById(`faq-modal-${uniqueId}`);
    const backdrop = document.getElementById(`faq-backdrop-${uniqueId}`);
    const panel = document.getElementById(`faq-panel-${uniqueId}`);

    if (!tab || !modal || !backdrop || !panel) return;

    function openDrawer() {
      // Enable pointer events
      modal.classList.remove('pointer-events-none');
      backdrop.classList.remove('pointer-events-none');
      panel.classList.remove('pointer-events-none');
      
      // Animate in
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        panel.classList.remove('-translate-x-full');
      }, 10);
      
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      // Animate out
      backdrop.classList.add('opacity-0');
      panel.classList.add('-translate-x-full');
      
      // Disable pointer events after transition
      setTimeout(() => {
        modal.classList.add('pointer-events-none');
        backdrop.classList.add('pointer-events-none');
        panel.classList.add('pointer-events-none');
        document.body.style.overflow = '';
      }, 300);
    }

    tab.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
  }

  // Initialize
  document.addEventListener('astro:page-load', () => setupFaqDrawer(id));
  setupFaqDrawer(id); // Run on initial load as well
</script>
