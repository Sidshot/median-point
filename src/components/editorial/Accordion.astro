---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="group my-8 border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden bg-white dark:bg-[#111]">
  <summary class="flex items-center justify-between cursor-pointer p-5 font-bold font-sans text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-900/50 transition-colors select-none">
    <span>{title}</span>
    <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>
  <div class="p-5 pt-2 border-t border-gray-100 dark:border-gray-800 text-gray-700 dark:text-gray-300 font-serif leading-relaxed prose dark:prose-invert max-w-none">
    <slot />
  </div>
</details>
