---
const { text } = Astro.props;
---
<div class="topline-block mb-8 pb-6 border-b-2 border-brand/20 dark:border-brand-dark/20">
	<div class="text-sm font-bold uppercase tracking-widest text-brand dark:text-brand-dark font-sans mb-3">Topline</div>
	<p class="text-xl md:text-2xl font-serif text-gray-800 dark:text-gray-200 leading-relaxed">{text}</p>
</div>
