---
import BlockWrapper from './BlockWrapper.astro';

interface Props {
  heading?: string;
  [key: string]: any;
}

const { heading = 'Key Facts', ...designProps } = Astro.props;

// If the user didn't specify a custom background in the CMS, provide a default
const defaultDesign = {
  bgColor: designProps.bgColor || 'rgba(0,0,0,0.03)',
  padding: designProps.padding || '1.5rem',
  borderRadius: designProps.borderRadius || '0.75rem',
  border: designProps.border || '1px solid rgba(0,0,0,0.1)',
};
const mergedProps = { ...defaultDesign, ...designProps };
---

<BlockWrapper {...mergedProps} class={`info-box not-prose my-8 ${designProps.class || ''}`}>
  <h4 class="text-sm font-bold uppercase tracking-widest text-brand dark:text-brand-dark font-sans mb-3">{heading}</h4>
  <div class="font-sans text-sm text-gray-800 dark:text-gray-200 prose prose-sm dark:prose-invert">
    <slot />
  </div>
</BlockWrapper>
