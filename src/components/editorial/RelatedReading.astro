---
import { getSafeLink } from '../../utils/urls';

interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description } = Astro.props;
const href = getSafeLink(url);
const isExternal = /^https?:\/\//i.test(href);
---

<a href={href} class="related-reading-card" target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
  <div class="related-reading-label">📖 Related Reading</div>
  <div class="related-reading-title">{title}</div>
  {description && <div class="related-reading-desc">{description}</div>}
  <div class="related-reading-arrow">Read more →</div>
</a>
