---
import { getSafeGoogleMapsEmbed } from '../../utils/urls';

interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;
const iframeSrc = getSafeGoogleMapsEmbed(url);
---

<figure class="my-10 w-full not-prose">
  {iframeSrc ? (
    <div class="relative w-full overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800" style="padding-top: 56.25%;">
      <iframe
        src={iframeSrc}
        title={caption || 'Embedded Google Map'}
        class="absolute top-0 left-0 w-full h-full border-0"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  ) : (
    <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300">
      This map could not be displayed because its embed URL is invalid.
    </p>
  )}
  {caption && (
    <figcaption class="mt-3 text-center text-sm font-serif text-gray-500 dark:text-gray-400 italic">
      {caption}
    </figcaption>
  )}
</figure>
