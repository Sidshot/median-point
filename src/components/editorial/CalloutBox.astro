---
interface Props {
  variant: 'info' | 'warning' | 'important' | 'tip';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const config: Record<string, { icon: string; defaultTitle: string; className: string }> = {
  info: { 
    icon: `<svg class="w-5 h-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`, 
    defaultTitle: 'Note', 
    className: 'callout-info' 
  },
  warning: { 
    icon: `<svg class="w-5 h-5 text-amber-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`, 
    defaultTitle: 'Warning', 
    className: 'callout-warning' 
  },
  important: { 
    icon: `<svg class="w-5 h-5 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`, 
    defaultTitle: 'Important', 
    className: 'callout-important' 
  },
  tip: { 
    icon: `<svg class="w-5 h-5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>`, 
    defaultTitle: 'Tip', 
    className: 'callout-tip' 
  },
};

const cfg = config[variant] || config.info;
const displayTitle = title || cfg.defaultTitle;
---

<aside class={`callout-box group my-8 rounded-xl bg-white dark:bg-[#1a1a1a] shadow-[0_8px_30px_rgb(0,0,0,0.06)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.2)] border border-gray-100 dark:border-white/5 overflow-hidden transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)] ${cfg.className}`} role="note">
  <div class="callout-header flex items-center gap-3 px-6 py-4 border-b border-gray-100 dark:border-gray-800/60 bg-gray-50/50 dark:bg-black/20">
    <span class="callout-icon flex items-center justify-center" set:html={cfg.icon}></span>
    <span class="callout-title font-sans font-bold text-sm tracking-widest uppercase text-gray-900 dark:text-gray-200">{displayTitle}</span>
  </div>
  <div class="callout-content px-6 py-5 font-serif text-gray-700 dark:text-gray-300 leading-relaxed text-base md:text-lg">
    <slot />
  </div>
</aside>
