---
import BlockWrapper from './BlockWrapper.astro';

interface Props {
  attribution?: string;
  [key: string]: any;
}

const { attribution, ...designProps } = Astro.props;
---

<BlockWrapper {...designProps} class={`pull-quote not-prose ${designProps.class || ''}`}>
  <figure role="figure" class="m-0 p-0">
    <div class="pull-quote-mark">"</div>
    <blockquote class="pull-quote-text">
      <slot />
    </blockquote>
    {attribution && (
      <figcaption class="pull-quote-attribution">— {attribution}</figcaption>
    )}
  </figure>
</BlockWrapper>
