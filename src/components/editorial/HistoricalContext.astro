---
import BlockWrapper from './BlockWrapper.astro';

interface Props {
  year?: string;
  [key: string]: any;
}

const { year, ...designProps } = Astro.props;

const defaultDesign = {
  padding: designProps.padding || '2rem 1.5rem',
  theme: designProps.theme || 'theme-nyt',
};
const mergedProps = { ...defaultDesign, ...designProps };
---

<BlockWrapper {...mergedProps} class={`historical-context my-10 border-t-4 border-b-4 border-gray-300 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/30 ${designProps.class || ''}`}>
  {year && <div class="text-4xl font-serif font-bold text-gray-400 dark:text-gray-500 mb-2 tracking-tight">{year}</div>}
  <div class="font-serif italic text-lg leading-relaxed text-gray-800 dark:text-gray-200">
    <slot />
  </div>
</BlockWrapper>
