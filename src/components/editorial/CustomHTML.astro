---
import BlockWrapper from './BlockWrapper.astro';
import { getSafeCustomEmbed, getSafeCustomEmbedHtml } from '../../utils/urls';

const { code = '', ...designProps } = Astro.props;
const safeEmbed = getSafeCustomEmbed(code);
const safeEmbedHtml = getSafeCustomEmbedHtml(code);
const tableauId = safeEmbed?.type === 'tableau'
  ? `tableau-viz-${safeEmbed.name.replace(/[^a-zA-Z0-9]+/g, '-').toLowerCase()}`
  : null;
---
<BlockWrapper {...designProps} class={`custom-html-block my-8 not-prose ${designProps.class || ''}`}>
  {safeEmbed?.type === 'tableau' ? (
    <div class="custom-embed-frame custom-embed-frame-tableau">
      <div class="tableau-placeholder" id={tableauId}>
        {safeEmbed.staticImage ? (
          <noscript>
            <a href={`https://public.tableau.com/views/${safeEmbed.name}`}>
              <img src={safeEmbed.staticImage} alt="Tableau visualization preview" style="border: none;" />
            </a>
          </noscript>
        ) : null}
        <object class="tableauViz" style="display:none;">
          <param name="host_url" value="https%3A%2F%2Fpublic.tableau.com%2F" />
          <param name="embed_code_version" value="3" />
          <param name="site_root" value="" />
          <param name="name" value={safeEmbed.name} />
          <param name="tabs" value={safeEmbed.tabs} />
          <param name="toolbar" value={safeEmbed.toolbar} />
          {safeEmbed.staticImage ? <param name="static_image" value={safeEmbed.staticImage} /> : null}
          <param name="animate_transition" value="yes" />
          <param name="display_static_image" value="yes" />
          <param name="display_spinner" value="yes" />
          <param name="display_overlay" value="yes" />
          <param name="display_count" value="yes" />
          <param name="language" value={safeEmbed.language} />
        </object>
      </div>
      <script is:inline define:vars={{ tableauId }}>
        (function () {
          var divElement = document.getElementById(tableauId);
          if (!divElement) return;

          var vizElement = divElement.getElementsByTagName('object')[0];
          if (!vizElement) return;

          vizElement.style.width = '100%';
          vizElement.style.minHeight = '860px';
          vizElement.style.display = 'block';

          if (!document.querySelector('script[src="https://public.tableau.com/javascripts/api/viz_v1.js"]')) {
            var scriptElement = document.createElement('script');
            scriptElement.src = 'https://public.tableau.com/javascripts/api/viz_v1.js';
            vizElement.parentNode.insertBefore(scriptElement, vizElement);
          }
        })();
      </script>
    </div>
  ) : safeEmbedHtml ? (
    <div class="custom-embed-frame" set:html={safeEmbedHtml} />
  ) : (
    <div class="embed-fallback-card">
      This embed could not be displayed. Paste a valid embed from Datawrapper, Tableau Public, Flourish, Lowy, YouTube, or Google Maps.
    </div>
  )}
</BlockWrapper>

<script is:inline>
  const scope = window;
  if (!scope.__mpDatawrapperResizeBound) {
    window.addEventListener('message', (event) => {
      const payload = event.data;
      if (!payload || typeof payload !== 'object' || !('datawrapper-height' in payload)) return;

      const heights = payload['datawrapper-height'];
      if (!heights || typeof heights !== 'object') return;

      Object.entries(heights).forEach(([id, height]) => {
        const iframe = document.getElementById(`datawrapper-chart-${id}`);
        const nextHeight = Number(height);
        if (iframe && Number.isFinite(nextHeight)) {
          iframe.style.height = `${Math.max(nextHeight, 360)}px`;
        }
      });
    });

    scope.__mpDatawrapperResizeBound = true;
  }
</script>

<style>
  .custom-embed-frame {
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .custom-embed-frame :global(iframe) {
    display: block;
    width: 100%;
  }

  .custom-embed-frame-tableau {
    padding: 0.25rem;
    overflow: hidden;
  }

  .custom-embed-frame-tableau :global(.tableau-placeholder) {
    width: 100%;
    min-height: 860px;
  }

  .embed-fallback-card {
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    color: rgb(100 116 139);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  :global(.dark) .custom-embed-frame,
  :global(.dark) .embed-fallback-card {
    border-color: rgba(148, 163, 184, 0.16);
    background: rgba(15, 23, 42, 0.5);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.24);
  }
</style>
