---
import BlockWrapper from './BlockWrapper.astro';

interface Props {
  layout?: '1-1' | '1-2' | '2-1';
  [key: string]: any;
}

const { layout = '1-1', ...designProps } = Astro.props;

let gridClass = 'grid-cols-1 md:grid-cols-2';
if (layout === '1-2') gridClass = 'grid-cols-1 md:grid-cols-3';
if (layout === '2-1') gridClass = 'grid-cols-1 md:grid-cols-3';
---

<BlockWrapper {...designProps} class={`grid gap-6 my-8 ${gridClass} columns-layout-${layout}`}>
  <slot />
</BlockWrapper>

<style is:global>
  /* Handle specific child spans for asymmetrical layouts */
  .columns-layout-1-2 > :first-child { grid-column: span 1; }
  .columns-layout-1-2 > :nth-child(2) { grid-column: span 2; }
  
  .columns-layout-2-1 > :first-child { grid-column: span 2; }
  .columns-layout-2-1 > :nth-child(2) { grid-column: span 1; }
  
  /* On mobile, they just stack (grid-cols-1) */
  @media (max-width: 768px) {
    .columns-layout-1-2 > :first-child,
    .columns-layout-1-2 > :nth-child(2),
    .columns-layout-2-1 > :first-child,
    .columns-layout-2-1 > :nth-child(2) {
      grid-column: span 1 / span 1;
    }
  }
</style>
