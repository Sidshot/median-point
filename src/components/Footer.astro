---
const today = new Date();
---

<footer class="bg-gray-100 dark:bg-[#0f0f0f] border-t border-gray-200 dark:border-gray-800 py-16 px-4 mt-auto">
	<div class="max-w-5xl mx-auto">
		<!-- Top row: brand + nav + newsletter -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
			<!-- Brand Column -->
			<div>
				<div class="flex items-center gap-2 mb-4">
					<div class="bg-gray-900 dark:bg-white text-white dark:text-gray-900 flex items-center justify-center w-8 h-8 rounded-lg font-bold text-sm">
						<span class="tracking-tighter pl-0.5">MP</span><span class="w-1 h-1 bg-brand rounded-full ml-0.5 mt-2"></span>
					</div>
					<span class="font-sans font-black text-lg text-gray-900 dark:text-gray-100">Median Point</span>
				</div>
				<p class="font-serif text-sm text-gray-500 dark:text-gray-400 italic leading-relaxed">
					"Finding the signal amidst the noise of global affairs."
				</p>
			</div>

			<!-- Navigation Column -->
			<div>
				<h4 class="text-sm font-bold font-sans uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-4">Navigate</h4>
				<ul class="space-y-2 font-sans text-sm">
					<li><a href="/" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors">Home</a></li>
					<li><a href="/archive" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors">Archive</a></li>
					<li><a href="/about" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors">About</a></li>
					<li><a href="/contact" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors">Contact</a></li>
					<li><a href="/rss.xml" target="_blank" class="text-gray-600 dark:text-gray-400 hover:text-brand dark:hover:text-brand-dark transition-colors">RSS Feed</a></li>
				</ul>
			</div>

			<!-- Newsletter Column -->
			<div>
				<h4 class="text-sm font-bold font-sans uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-4">Newsletter</h4>
				<p class="text-sm font-serif text-gray-600 dark:text-gray-400 mb-4">
					A weekly dispatch on the center of global power. No spam, only signal.
				</p>
				<form action="https://medianpoint.substack.com/subscribe" method="GET" class="flex flex-col sm:flex-row gap-2">
					<input type="email" name="email" placeholder="Your email address" required class="flex-grow px-4 py-2.5 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 rounded-md focus:ring-2 focus:ring-brand focus:outline-none text-sm text-base dark:text-base-dark font-sans" />
					<button type="submit" class="bg-brand hover:bg-red-800 text-white font-bold uppercase tracking-wider text-xs px-5 py-2.5 rounded-md transition-colors shrink-0">
						Subscribe
					</button>
				</form>
			</div>
		</div>

		<!-- Divider -->
		<div class="flex items-center justify-center mb-8 opacity-30">
			<div class="h-[1px] flex-grow bg-gray-400 dark:bg-gray-700"></div>
			<div class="mx-4 text-gray-400 dark:text-gray-600 text-xs">❖</div>
			<div class="h-[1px] flex-grow bg-gray-400 dark:bg-gray-700"></div>
		</div>
		
		<div class="text-center text-sm text-gray-500 dark:text-gray-600 font-sans">
			&copy; {today.getFullYear()} Median Point. All rights reserved.
		</div>
	</div>
</footer>
