---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Extract unique regions (assuming category maps to region)
const regions = [...new Set(posts.map((post) => post.data.category || 'Analysis'))];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Archive | ${SITE_TITLE}`} description="Browse the Median Point archive by region." />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-[720px] mx-auto px-4 py-12 w-full">
			<h1 class="text-4xl font-black mb-8">Archive</h1>
			
			<div class="mb-10">
				<h3 class="text-sm font-bold font-sans uppercase tracking-wider mb-3 text-gray-500">Filter by Region</h3>
				<div class="flex flex-wrap gap-2" id="filter-buttons">
					<button class="filter-btn active bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-200 px-4 py-2 text-sm font-sans font-bold rounded-sm hover:bg-gray-300 dark:hover:bg-gray-700 transition" data-region="all">
						All
					</button>
					{regions.map((region) => (
						<button class="filter-btn bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 px-4 py-2 text-sm font-sans font-medium rounded-sm hover:bg-gray-200 dark:hover:bg-gray-800 transition" data-region={region}>
							{region}
						</button>
					))}
				</div>
			</div>

			<ul class="space-y-6" id="archive-list">
				{
					posts.map((post) => (
						<li class="group border-b border-gray-100 dark:border-gray-800 pb-6 archive-item" data-region={post.data.category || 'Analysis'}>
							<a href={`/blog/${post.id}/`} class="block no-underline">
								<div class="flex items-center justify-between mb-1">
									<div class="text-xs text-brand dark:text-brand-dark font-sans font-bold uppercase tracking-wider bg-red-50 dark:bg-red-900/20 px-2 py-1 rounded inline-block">
										{post.data.category || 'Analysis'}
									</div>
									<div class="text-sm text-gray-500 font-sans">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</div>
								<h3 class="text-xl font-bold mt-2 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-tight">
									{post.data.title}
								</h3>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />

		<script>
			const buttons = document.querySelectorAll('.filter-btn');
			const items = document.querySelectorAll('.archive-item');

			buttons.forEach(btn => {
				btn.addEventListener('click', () => {
					// UI update
					buttons.forEach(b => {
						b.classList.remove('active', 'bg-gray-200', 'dark:bg-gray-800', 'text-gray-800', 'dark:text-gray-200', 'font-bold');
						b.classList.add('bg-gray-100', 'dark:bg-gray-900', 'text-gray-600', 'dark:text-gray-400', 'font-medium');
					});
					
					btn.classList.add('active', 'bg-gray-200', 'dark:bg-gray-800', 'text-gray-800', 'dark:text-gray-200', 'font-bold');
					btn.classList.remove('bg-gray-100', 'dark:bg-gray-900', 'text-gray-600', 'dark:text-gray-400', 'font-medium');

					// Filtering
					const selectedRegion = (btn as HTMLElement).dataset.region;
					
					items.forEach(item => {
						const itemRegion = (item as HTMLElement).dataset.region;
						if (selectedRegion === 'all' || itemRegion === selectedRegion) {
							(item as HTMLElement).style.display = 'block';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>
