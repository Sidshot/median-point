---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Contact Median Point for speaking and analysis inquiries." />
	</head>
	<body class="flex flex-col min-h-screen bg-bg dark:bg-bg-dark">
		<Header />
		<main class="flex-grow max-w-[720px] mx-auto px-4 w-full flex flex-col items-center justify-center text-center mt-20 mb-20">
			<h1 class="text-4xl md:text-5xl font-black mb-6">Contact</h1>
			<p class="text-xl text-gray-600 dark:text-gray-400 font-serif mb-10 max-w-lg">
				For speaking engagements, consulting, or general inquiries, please reach out via email.
			</p>
			
			<a href="mailto:indocurry@protonmail.me" class="inline-flex items-center justify-center px-10 py-4 border border-transparent text-lg font-bold rounded-sm text-white bg-brand hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand transition-all shadow-lg hover:-translate-y-1">
				Contact Us
			</a>
		</main>
		<Footer />
	</body>
</html>
