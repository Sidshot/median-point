---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GlassLogo from "../components/GlassLogo.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog"))
	.filter((post) => !post.data.isDraft)
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const getReadingTime = (content) => {
	if (!content) return 1;
	const wordCount = content.split(/\s+/).length;
	return Math.max(1, Math.ceil(wordCount / 200));
};

// Task 7: Extract first image from article body (MDX/Markdown)
const getFirstImage = (body) => {
	if (!body) return null;
	// Match markdown images: ![alt](url)
	const mdMatch = body.match(/!\[.*?\]\((.*?)\)/);
	if (mdMatch) return mdMatch[1];
	// Match HTML img tags: <img src="url"
	const htmlMatch = body.match(/<img[^>]+src=["']([^"']+)["']/);
	if (htmlMatch) return htmlMatch[1];
	return null;
};

const formatDateShort = (date) => {
	return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Median Point",
			"url": "https://median-point.vercel.app",
			"description": SITE_DESCRIPTION,
			"publisher": {
				"@type": "Organization",
				"name": "Median Point",
				"url": "https://median-point.vercel.app",
				"logo": {
					"@type": "ImageObject",
					"url": "https://median-point.vercel.app/favicon.svg"
				}
			},
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": "https://median-point.vercel.app/search?q={search_term_string}"
				},
				"query-input": "required name=search_term_string"
			},
			"inLanguage": "en-US"
		})} />
	</head>
	<body class="home-page flex flex-col min-h-screen relative bg-bg dark:bg-bg-dark">
		<Header />

		<main class="home-canvas flex-grow">
			<!-- ═══════════════════════════════════════════ -->
			<!-- MASTHEAD — Clean, Editorial, Minimal       -->
			<!-- ═══════════════════════════════════════════ -->
			<div class="masthead-shell border-b border-gray-200 dark:border-gray-800">
				<div class="masthead-content max-w-6xl mx-auto px-4 py-6 md:py-10 text-center">
					<GlassLogo />
					<p class="masthead-subtitle text-base md:text-lg text-gray-500 dark:text-gray-400 font-serif italic max-w-xl mx-auto">
						Navigating the true center of global power.
					</p>
					<div class="masthead-topics flex items-center justify-center mt-4 text-xs font-sans uppercase tracking-widest text-gray-400 dark:text-gray-600">
						<span>Geopolitics</span>
						<span class="mx-3 text-brand">·</span>
						<span>Defense</span>
						<span class="mx-3 text-brand">·</span>
						<span>India</span>
						<span class="mx-3 text-brand">·</span>
						<span>Global Affairs</span>
					</div>
				</div>
			</div>

			<!-- ═══════════════════════════════════════════ -->
			<!-- FEATURED STORY — Newspaper-style hero      -->
			<!-- ═══════════════════════════════════════════ -->
			{featuredPost && (
				<section class="featured-story border-b border-gray-200 dark:border-gray-800">
					<div class="max-w-6xl mx-auto px-4 py-10 md:py-14">
						<a href={`/blog/${featuredPost.id}/`} class="block no-underline group">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
								{/* Article Image */}
								{getFirstImage(featuredPost.body) ? (
									<div class="featured-image-shell overflow-hidden rounded-lg">
										<img 
											src={getFirstImage(featuredPost.body)} 
											alt={featuredPost.data.title}
											class="w-full h-64 md:h-80 object-cover group-hover:scale-[1.02] transition-transform duration-500"
											loading="eager"
										/>
									</div>
								) : (
									<div class="w-full h-64 md:h-80 bg-gray-100 dark:bg-gray-900 rounded-lg flex items-center justify-center">
										<span class="text-5xl font-serif font-bold text-gray-200 dark:text-gray-800">MP</span>
									</div>
								)}
								{/* Article Content */}
								<div>
									<div class="flex items-center gap-3 mb-4">
										<span class="text-xs font-bold text-white bg-brand dark:bg-brand-dark px-3 py-1 rounded-sm uppercase tracking-widest font-sans">
											{featuredPost.data.category || "Analysis"}
										</span>
										<span class="text-xs font-bold text-brand dark:text-brand-dark uppercase tracking-widest font-sans">
											Featured
										</span>
									</div>
									<h2 class="text-3xl md:text-4xl font-black mb-4 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-tight font-sans">
										{featuredPost.data.title}
									</h2>
									<p class="text-lg text-gray-600 dark:text-gray-400 font-serif mb-5 leading-relaxed line-clamp-3">
										{featuredPost.data.description}
									</p>
									<div class="flex items-center text-sm text-gray-500 font-sans gap-3">
										<img src="/sudhanshu.png" alt="Author" class="w-7 h-7 rounded-full object-cover border border-gray-200 dark:border-gray-700" />
										<span class="font-medium text-gray-700 dark:text-gray-300">{featuredPost.data.author || "Sudhanshu Verma"}</span>
										<span class="opacity-50">·</span>
										<FormattedDate date={featuredPost.data.pubDate} />
										<span class="opacity-50">·</span>
										<span>{getReadingTime(featuredPost.body)} min read</span>
									</div>
								</div>
							</div>
						</a>
					</div>
				</section>
			)}

			<!-- ═══════════════════════════════════════════ -->
			<!-- ARTICLE GRID — Clean cards with images     -->
			<!-- ═══════════════════════════════════════════ -->
			<section class="insights-section max-w-6xl mx-auto px-4 py-12">
				<h2 class="text-xl font-bold mb-8 flex items-center font-sans">
					<span class="bg-brand dark:bg-brand-dark w-1 h-5 mr-3 block rounded-sm"></span>
					Latest Insights
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{remainingPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="block no-underline group">
							<article class="insight-card bg-white dark:bg-[#111] border border-gray-200/60 dark:border-gray-800 rounded-lg overflow-hidden hover:shadow-lg dark:hover:shadow-brand/5 hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
								{/* Article Thumbnail */}
								{getFirstImage(post.body) ? (
									<div class="overflow-hidden">
										<img 
											src={getFirstImage(post.body)} 
											alt={post.data.title}
											class="w-full h-48 object-cover group-hover:scale-[1.03] transition-transform duration-500"
											loading="lazy"
										/>
									</div>
								) : (
									<div class="w-full h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center border-b border-gray-100 dark:border-gray-800">
										<span class="text-3xl font-serif font-bold text-gray-200 dark:text-gray-800">MP</span>
									</div>
								)}
								<div class="p-5 flex flex-col flex-grow">
									<div class="text-xs font-bold text-brand dark:text-brand-dark font-sans uppercase tracking-widest mb-2">
										{post.data.category || "Analysis"}
									</div>
									<h3 class="text-lg font-bold mb-3 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-snug font-sans flex-grow">
										{post.data.title}
									</h3>
									<p class="text-sm text-gray-600 dark:text-gray-400 font-serif mb-4 line-clamp-2 leading-relaxed">
										{post.data.description}
									</p>
									<div class="mt-auto pt-3 border-t border-gray-100 dark:border-gray-800 text-xs text-gray-500 font-sans flex items-center justify-between">
										<div class="flex items-center gap-2">
											<FormattedDate date={post.data.pubDate} />
											<span class="opacity-50">·</span>
											<span>{getReadingTime(post.body)} min</span>
										</div>
										<span class="text-brand dark:text-brand-dark opacity-0 group-hover:opacity-100 transition-opacity font-medium">
											Read →
										</span>
									</div>
								</div>
							</article>
						</a>
					))}
				</div>
			</section>

			<!-- ═══════════════════════════════════════════ -->
			<!-- NEWSLETTER CTA — Clean editorial banner    -->
			<!-- ═══════════════════════════════════════════ -->
			<section class="weekly-briefing-section border-t border-gray-200 dark:border-gray-800">
				<div class="weekly-briefing-panel max-w-3xl mx-auto px-4 py-14 text-center">
					<h2 class="text-2xl md:text-3xl font-black font-sans mb-3 text-gray-900 dark:text-gray-100">The Weekly Briefing</h2>
					<p class="text-lg text-gray-500 dark:text-gray-400 font-serif mb-6 max-w-xl mx-auto">
						Join geopolitical analysts, defense experts, and policymakers who rely on our weekly analysis. No spam, only signal.
					</p>
					<a href="https://medianpoint.substack.com/subscribe" class="inline-flex items-center px-8 py-3 bg-brand hover:bg-red-800 text-white font-bold rounded-md transition-colors text-sm uppercase tracking-widest font-sans">
						Subscribe →
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.home-page {
		background: #f1f4f7;
	}

	.home-canvas {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.86), transparent 26rem),
			radial-gradient(circle at 92% 48%, rgba(191, 219, 254, 0.24), transparent 31rem),
			linear-gradient(180deg, #f3f5f8 0%, #eef2f6 56%, #e9eef4 100%);
		isolation: isolate;
	}

	.home-canvas::before {
		content: "";
		position: absolute;
		z-index: -1;
		top: 20rem;
		right: -19rem;
		width: 42rem;
		aspect-ratio: 1;
		border: 1px solid rgba(71, 85, 105, 0.055);
		border-radius: 50%;
		background:
			linear-gradient(90deg, transparent 49.8%, rgba(71, 85, 105, 0.045) 50%, transparent 50.2%),
			linear-gradient(transparent 49.8%, rgba(71, 85, 105, 0.045) 50%, transparent 50.2%),
			repeating-conic-gradient(
				from 22.5deg,
				rgba(71, 85, 105, 0.035) 0deg 0.5deg,
				transparent 0.5deg 45deg
			);
		box-shadow:
			0 0 0 5rem rgba(148, 163, 184, 0.018),
			0 0 0 10rem rgba(148, 163, 184, 0.012);
		filter: blur(0.4px);
		pointer-events: none;
	}

	.featured-story,
	.insights-section,
	.weekly-briefing-section {
		position: relative;
		z-index: 1;
	}

	.featured-story {
		border-bottom-color: rgba(148, 163, 184, 0.28);
		background: transparent;
	}

	.featured-image-shell {
		border: 1px solid rgba(255, 255, 255, 0.72);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.82) inset,
			0 16px 38px rgba(71, 85, 105, 0.13),
			0 4px 12px rgba(59, 130, 246, 0.07);
	}

	.insight-card {
		border-color: rgba(148, 163, 184, 0.26);
		background: rgba(255, 255, 255, 0.62);
		-webkit-backdrop-filter: blur(18px) saturate(1.12);
		backdrop-filter: blur(18px) saturate(1.12);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.82) inset,
			0 12px 30px rgba(71, 85, 105, 0.085);
	}

	.insight-card:hover {
		border-color: rgba(96, 165, 250, 0.36);
		background: rgba(255, 255, 255, 0.76);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 20px 42px rgba(71, 85, 105, 0.13),
			0 5px 14px rgba(59, 130, 246, 0.08);
	}

	.weekly-briefing-section {
		padding: 1rem 1rem 4rem;
		border-top-color: rgba(148, 163, 184, 0.26);
	}

	.weekly-briefing-panel {
		border: 1px solid rgba(255, 255, 255, 0.7);
		border-radius: 1.5rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(239, 246, 255, 0.52));
		-webkit-backdrop-filter: blur(22px) saturate(1.15);
		backdrop-filter: blur(22px) saturate(1.15);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.92) inset,
			0 22px 52px rgba(71, 85, 105, 0.11),
			0 6px 18px rgba(59, 130, 246, 0.055);
	}

	:global(.home-page header) {
		border-bottom-color: rgba(148, 163, 184, 0.3);
		background: rgba(243, 245, 248, 0.86);
	}

	:global(.home-page > footer) {
		border-top-color: rgba(148, 163, 184, 0.18);
		background:
			radial-gradient(circle at 18% 0%, rgba(59, 130, 246, 0.11), transparent 25rem),
			linear-gradient(145deg, #1a2638 0%, #111b2a 58%, #0c1522 100%);
		box-shadow: 0 -18px 45px rgba(51, 65, 85, 0.08);
	}

	:global(.home-page > footer p),
	:global(.home-page > footer li a) {
		color: #a8b4c5;
	}

	:global(.home-page > footer h4),
	:global(.home-page > footer > div > div:last-child) {
		color: #7f8da1;
	}

	:global(.home-page > footer input) {
		border-color: rgba(148, 163, 184, 0.34);
		background: rgba(15, 23, 42, 0.58);
		color: #e2e8f0;
	}

	:global(.dark .home-page) {
		background: #0b1120;
	}

	:global(.dark) .home-canvas {
		background:
			radial-gradient(circle at 9% 21%, rgba(30, 41, 59, 0.7), transparent 27rem),
			radial-gradient(circle at 92% 48%, rgba(37, 99, 235, 0.1), transparent 31rem),
			linear-gradient(180deg, #0f172a 0%, #0c1423 56%, #09111e 100%);
	}

	:global(.dark) .home-canvas::before {
		border-color: rgba(191, 219, 254, 0.04);
		opacity: 0.68;
	}

	:global(.dark) .featured-story {
		border-bottom-color: rgba(71, 85, 105, 0.54);
	}

	:global(.dark) .featured-image-shell {
		border-color: rgba(148, 163, 184, 0.18);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.08) inset,
			0 18px 44px rgba(0, 0, 0, 0.3),
			0 5px 16px rgba(37, 99, 235, 0.11);
	}

	:global(.dark) .insight-card {
		border-color: rgba(100, 116, 139, 0.28);
		background: rgba(15, 23, 42, 0.58);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.055) inset,
			0 15px 34px rgba(0, 0, 0, 0.22);
	}

	:global(.dark) .insight-card:hover {
		border-color: rgba(96, 165, 250, 0.3);
		background: rgba(20, 31, 50, 0.78);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.075) inset,
			0 22px 48px rgba(0, 0, 0, 0.3),
			0 6px 18px rgba(37, 99, 235, 0.1);
	}

	:global(.dark) .weekly-briefing-section {
		border-top-color: rgba(71, 85, 105, 0.5);
	}

	:global(.dark) .weekly-briefing-panel {
		border-color: rgba(100, 116, 139, 0.26);
		background:
			linear-gradient(135deg, rgba(20, 31, 50, 0.76), rgba(15, 23, 42, 0.54));
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.065) inset,
			0 24px 58px rgba(0, 0, 0, 0.26),
			0 7px 20px rgba(37, 99, 235, 0.08);
	}

	:global(.dark .home-page header) {
		border-bottom-color: rgba(71, 85, 105, 0.54);
		background: rgba(11, 17, 32, 0.86);
	}

	:global(.dark .home-page > footer) {
		border-top-color: rgba(71, 85, 105, 0.34);
		background:
			radial-gradient(circle at 18% 0%, rgba(37, 99, 235, 0.09), transparent 25rem),
			linear-gradient(145deg, #080e18 0%, #070c14 58%, #050910 100%);
	}

	@media (max-width: 640px) {
		.home-canvas::before {
			top: 33rem;
			right: -28rem;
		}

		.weekly-briefing-section {
			padding-right: 0.75rem;
			padding-bottom: 3rem;
			padding-left: 0.75rem;
		}

		.weekly-briefing-panel {
			border-radius: 1.25rem;
		}
	}
</style>
