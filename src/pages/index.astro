---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col min-h-screen relative bg-bg dark:bg-bg-dark">
		
		<!-- Intricate Indian Floral Watermark Background -->
		<div class="fixed inset-0 pointer-events-none z-[-1] opacity-[0.03] dark:opacity-[0.07] dark:invert transition-opacity duration-300" style="background-image: url('/floral-bg.png'); background-repeat: repeat; background-size: 500px;"></div>

		<Header />
		
		<main class="flex-grow z-10">
			<!-- Decorative Hero Section -->
			<section class="text-center py-24 px-4 bg-gray-50/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 shadow-sm relative overflow-hidden">
				
				<div class="relative max-w-4xl mx-auto">
					<!-- Top Architectural Divider -->
					<div class="flex items-center justify-center mb-8 opacity-40">
						<div class="h-[1px] w-16 bg-gray-600 dark:bg-gray-400"></div>
						<div class="mx-3 text-gray-500 dark:text-gray-400">✦</div>
						<div class="h-[1px] w-16 bg-gray-600 dark:bg-gray-400"></div>
					</div>

					<h1 class="text-5xl md:text-7xl font-black tracking-tight mb-6 text-gray-900 dark:text-gray-100 font-sans uppercase">
						Median Point
					</h1>
					
					<p class="text-xl md:text-3xl text-gray-700 dark:text-gray-300 font-serif italic max-w-2xl mx-auto leading-relaxed">
						"Navigating the true center of global power."
					</p>

					<!-- Bottom Architectural Divider -->
					<div class="flex items-center justify-center mt-8 opacity-40">
						<div class="h-[1px] w-24 bg-gray-600 dark:bg-gray-400"></div>
						<div class="mx-4 text-brand dark:text-brand-dark">❖</div>
						<div class="h-[1px] w-24 bg-gray-600 dark:bg-gray-400"></div>
					</div>
				</div>
			</section>
			
			<!-- Article Grid Section -->
			<section class="max-w-5xl mx-auto px-4 py-16">
				<h2 class="text-2xl font-bold mb-10 flex items-center">
					<span class="bg-brand dark:bg-brand-dark w-1.5 h-6 mr-3 block rounded-sm"></span> 
					Latest Insights
				</h2>

				<!-- Featured Article (Full Width) -->
				{featuredPost && (
					<a href={`/blog/${featuredPost.id}/`} class="block no-underline mb-14 group">
						<article class="bg-gradient-to-br from-gray-50 to-white dark:from-[#151515] dark:to-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1">
							<div class="p-8 md:p-12">
								<div class="flex items-center gap-3 mb-4">
									<span class="text-xs font-bold text-white bg-brand dark:bg-brand-dark px-3 py-1 rounded-full uppercase tracking-widest">
										{featuredPost.data.category || 'Analysis'}
									</span>
									<span class="text-xs font-bold text-brand dark:text-brand-dark uppercase tracking-widest">Featured</span>
								</div>
								<h3 class="text-3xl md:text-5xl font-black mb-5 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-tight font-sans">
									{featuredPost.data.title}
								</h3>
								<p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 font-serif mb-6 leading-relaxed max-w-3xl line-clamp-3">
									{featuredPost.data.description}
								</p>
								<div class="flex items-center justify-between">
									<div class="flex items-center text-sm text-gray-500 dark:text-gray-500 font-sans">
										<img src="/sudhanshu.png" alt="Sudhanshu Verma" class="w-8 h-8 rounded-full object-cover mr-3 border border-gray-200 dark:border-gray-700" />
										<span class="font-medium text-gray-700 dark:text-gray-300">{featuredPost.data.author || 'Sudhanshu Verma'}</span>
										<span class="mx-2 opacity-50">·</span>
										<FormattedDate date={featuredPost.data.pubDate} />
									</div>
									<span class="text-brand dark:text-brand-dark font-sans font-bold text-sm opacity-0 group-hover:opacity-100 transition-opacity">Read Full Analysis →</span>
								</div>
							</div>
						</article>
					</a>
				)}

				<!-- Inline Newsletter CTA (Item 15) -->
				<div class="mb-14 bg-gradient-to-r from-gray-900 to-gray-800 dark:from-gray-800 dark:to-gray-900 text-white rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
					<div>
						<div class="text-sm font-bold uppercase tracking-widest text-brand-dark mb-2">📬 Stay Informed</div>
						<p class="text-lg font-serif italic opacity-90">Get geopolitical analysis delivered to your inbox. No spam, only signal.</p>
					</div>
					<a href="https://medianpoint.substack.com/subscribe" class="shrink-0 inline-flex items-center px-6 py-3 bg-brand hover:bg-red-800 text-white font-bold rounded-md transition-colors text-sm uppercase tracking-wider">
						Subscribe
					</a>
				</div>
				
				<!-- 2-Column Grid for remaining posts -->
				<ul class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
					{
						remainingPosts.map((post) => (
							<li class="group bg-white/60 dark:bg-[#151515]/80 backdrop-blur-sm border border-gray-100 dark:border-gray-800 p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-lg dark:hover:shadow-brand/5 hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
								<a href={`/blog/${post.id}/`} class="block no-underline flex-grow flex flex-col">
									<div class="text-xs font-bold text-brand dark:text-brand-dark font-sans uppercase tracking-widest mb-3">
										{post.data.category || 'Analysis'}
									</div>
									<h3 class="text-2xl md:text-3xl font-bold mb-4 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-tight font-sans">
										{post.data.title}
									</h3>
									<p class="text-lg text-gray-600 dark:text-gray-400 font-serif mb-6 line-clamp-3 leading-relaxed flex-grow">
										{post.data.description}
									</p>
									<div class="mt-auto pt-4 border-t border-gray-100 dark:border-gray-800 text-sm text-gray-500 dark:text-gray-500 font-sans flex items-center justify-between">
										<div class="flex items-center">
											<FormattedDate date={post.data.pubDate} />
											<span class="mx-2 opacity-50">•</span>
											<span class="font-medium text-gray-700 dark:text-gray-300">{post.data.author || 'Sudhanshu Verma'}</span>
										</div>
										<span class="text-brand dark:text-brand-dark opacity-0 group-hover:opacity-100 transition-opacity">Read →</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
