---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const getReadingTime = (content) => {
	if (!content) return 1;
	const wordCount = content.split(/\s+/).length;
	return Math.max(1, Math.ceil(wordCount / 200));
};

// Task 7: Extract first image from article body (MDX/Markdown)
const getFirstImage = (body) => {
	if (!body) return null;
	// Match markdown images: ![alt](url)
	const mdMatch = body.match(/!\[.*?\]\((.*?)\)/);
	if (mdMatch) return mdMatch[1];
	// Match HTML img tags: <img src="url"
	const htmlMatch = body.match(/<img[^>]+src=["']([^"']+)["']/);
	if (htmlMatch) return htmlMatch[1];
	return null;
};

const formatDateShort = (date) => {
	return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col min-h-screen relative bg-bg dark:bg-bg-dark">
		<Header />

		<main class="flex-grow">
			<!-- ═══════════════════════════════════════════ -->
			<!-- MASTHEAD — Clean, Editorial, Minimal       -->
			<!-- ═══════════════════════════════════════════ -->
			<div class="border-b border-gray-200 dark:border-gray-800">
				<div class="max-w-6xl mx-auto px-4 py-8 md:py-12 text-center">
					<h1 class="font-serif font-bold text-4xl md:text-5xl lg:text-6xl tracking-tight text-blue-700 dark:text-blue-500 mb-3 uppercase">
						Median Point
					</h1>
					<p class="text-base md:text-lg text-gray-500 dark:text-gray-400 font-serif italic max-w-xl mx-auto">
						Navigating the true center of global power.
					</p>
					<div class="flex items-center justify-center mt-4 text-xs font-sans uppercase tracking-widest text-gray-400 dark:text-gray-600">
						<span>Geopolitics</span>
						<span class="mx-3 text-brand">·</span>
						<span>Defense</span>
						<span class="mx-3 text-brand">·</span>
						<span>India</span>
						<span class="mx-3 text-brand">·</span>
						<span>Global Affairs</span>
					</div>
				</div>
			</div>

			<!-- ═══════════════════════════════════════════ -->
			<!-- FEATURED STORY — Newspaper-style hero      -->
			<!-- ═══════════════════════════════════════════ -->
			{featuredPost && (
				<section class="border-b border-gray-200 dark:border-gray-800">
					<div class="max-w-6xl mx-auto px-4 py-10 md:py-14">
						<a href={`/blog/${featuredPost.id}/`} class="block no-underline group">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
								{/* Article Image */}
								{getFirstImage(featuredPost.body) ? (
									<div class="overflow-hidden rounded-lg">
										<img 
											src={getFirstImage(featuredPost.body)} 
											alt={featuredPost.data.title}
											class="w-full h-64 md:h-80 object-cover group-hover:scale-[1.02] transition-transform duration-500"
											loading="eager"
										/>
									</div>
								) : (
									<div class="w-full h-64 md:h-80 bg-gray-100 dark:bg-gray-900 rounded-lg flex items-center justify-center">
										<span class="text-5xl font-serif font-bold text-gray-200 dark:text-gray-800">MP</span>
									</div>
								)}
								{/* Article Content */}
								<div>
									<div class="flex items-center gap-3 mb-4">
										<span class="text-xs font-bold text-white bg-brand dark:bg-brand-dark px-3 py-1 rounded-sm uppercase tracking-widest font-sans">
											{featuredPost.data.category || "Analysis"}
										</span>
										<span class="text-xs font-bold text-brand dark:text-brand-dark uppercase tracking-widest font-sans">
											Featured
										</span>
									</div>
									<h2 class="text-3xl md:text-4xl font-black mb-4 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-tight font-sans">
										{featuredPost.data.title}
									</h2>
									<p class="text-lg text-gray-600 dark:text-gray-400 font-serif mb-5 leading-relaxed line-clamp-3">
										{featuredPost.data.description}
									</p>
									<div class="flex items-center text-sm text-gray-500 font-sans gap-3">
										<img src="/sudhanshu.png" alt="Author" class="w-7 h-7 rounded-full object-cover border border-gray-200 dark:border-gray-700" />
										<span class="font-medium text-gray-700 dark:text-gray-300">{featuredPost.data.author || "Sudhanshu Verma"}</span>
										<span class="opacity-50">·</span>
										<FormattedDate date={featuredPost.data.pubDate} />
										<span class="opacity-50">·</span>
										<span>{getReadingTime(featuredPost.body)} min read</span>
									</div>
								</div>
							</div>
						</a>
					</div>
				</section>
			)}

			<!-- ═══════════════════════════════════════════ -->
			<!-- ARTICLE GRID — Clean cards with images     -->
			<!-- ═══════════════════════════════════════════ -->
			<section class="max-w-6xl mx-auto px-4 py-12">
				<h2 class="text-xl font-bold mb-8 flex items-center font-sans">
					<span class="bg-brand dark:bg-brand-dark w-1 h-5 mr-3 block rounded-sm"></span>
					Latest Insights
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{remainingPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="block no-underline group">
							<article class="bg-white dark:bg-[#111] border border-gray-200/60 dark:border-gray-800 rounded-lg overflow-hidden hover:shadow-lg dark:hover:shadow-brand/5 hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
								{/* Article Thumbnail */}
								{getFirstImage(post.body) ? (
									<div class="overflow-hidden">
										<img 
											src={getFirstImage(post.body)} 
											alt={post.data.title}
											class="w-full h-48 object-cover group-hover:scale-[1.03] transition-transform duration-500"
											loading="lazy"
										/>
									</div>
								) : (
									<div class="w-full h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center border-b border-gray-100 dark:border-gray-800">
										<span class="text-3xl font-serif font-bold text-gray-200 dark:text-gray-800">MP</span>
									</div>
								)}
								<div class="p-5 flex flex-col flex-grow">
									<div class="text-xs font-bold text-brand dark:text-brand-dark font-sans uppercase tracking-widest mb-2">
										{post.data.category || "Analysis"}
									</div>
									<h3 class="text-lg font-bold mb-3 text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-snug font-sans flex-grow">
										{post.data.title}
									</h3>
									<p class="text-sm text-gray-600 dark:text-gray-400 font-serif mb-4 line-clamp-2 leading-relaxed">
										{post.data.description}
									</p>
									<div class="mt-auto pt-3 border-t border-gray-100 dark:border-gray-800 text-xs text-gray-500 font-sans flex items-center justify-between">
										<div class="flex items-center gap-2">
											<FormattedDate date={post.data.pubDate} />
											<span class="opacity-50">·</span>
											<span>{getReadingTime(post.body)} min</span>
										</div>
										<span class="text-brand dark:text-brand-dark opacity-0 group-hover:opacity-100 transition-opacity font-medium">
											Read →
										</span>
									</div>
								</div>
							</article>
						</a>
					))}
				</div>
			</section>

			<!-- ═══════════════════════════════════════════ -->
			<!-- NEWSLETTER CTA — Clean editorial banner    -->
			<!-- ═══════════════════════════════════════════ -->
			<section class="border-t border-gray-200 dark:border-gray-800">
				<div class="max-w-3xl mx-auto px-4 py-14 text-center">
					<h2 class="text-2xl md:text-3xl font-black font-sans mb-3 text-gray-900 dark:text-gray-100">The Weekly Briefing</h2>
					<p class="text-lg text-gray-500 dark:text-gray-400 font-serif mb-6 max-w-xl mx-auto">
						Join geopolitical analysts, defense experts, and policymakers who rely on our weekly analysis. No spam, only signal.
					</p>
					<a href="https://medianpoint.substack.com/subscribe" class="inline-flex items-center px-8 py-3 bg-brand hover:bg-red-800 text-white font-bold rounded-md transition-colors text-sm uppercase tracking-widest font-sans">
						Subscribe →
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
