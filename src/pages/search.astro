---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Search — Median Point" description="Search articles on Median Point." />
	</head>
	<body class="flex flex-col min-h-screen bg-bg dark:bg-bg-dark">
		<Header />
		<main class="flex-grow max-w-3xl mx-auto px-4 py-12 w-full">
			<h1 class="text-3xl md:text-4xl font-black font-sans mb-8">Search</h1>
			<div class="relative mb-10">
				<label for="search-input" class="sr-only">Search articles</label>
				<input
					id="search-input"
					type="search"
					placeholder="Search articles by title, topic, or keyword..."
					class="w-full px-5 py-4 text-lg font-serif bg-white dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-700 rounded-xl focus:border-brand dark:focus:border-brand-dark focus:outline-none transition-colors text-gray-900 dark:text-gray-100 placeholder-gray-400"
					autocomplete="off"
					autofocus
				/>
				<svg aria-hidden="true" class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
			</div>
			<div id="search-results" class="space-y-6" aria-live="polite"></div>
			<div id="search-empty" class="hidden text-center py-16">
				<p class="text-xl text-gray-400 font-serif italic">No articles found matching your search.</p>
			</div>
			<div id="search-initial" class="text-center py-16">
				<p class="text-lg text-gray-400 font-serif italic">Start typing to search across all articles...</p>
			</div>
		</main>
		<Footer />

		<script>
			interface SearchPost {
				title: string;
				description: string;
				category: string;
				tags: string[];
				slug: string;
				pubDate: string;
				author: string;
			}

			type SearchWindow = Window & {
				__searchDataPromise?: Promise<SearchPost[]>;
				__searchPageLoadBound?: boolean;
			};

			const searchWindow = window as SearchWindow;
			let searchData: SearchPost[] = [];
			let debounceTimer = 0;

			function loadSearchIndex() {
				searchWindow.__searchDataPromise ??= fetch('/search.json')
					.then((response) => {
						if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
						return response.json() as Promise<SearchPost[]>;
					})
					.catch(() => []);

				return searchWindow.__searchDataPromise;
			}

			function formatDate(dateString: string) {
				return new Date(dateString).toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				});
			}

			function createTextElement<K extends keyof HTMLElementTagNameMap>(
				tag: K,
				className: string,
				text: string,
			) {
				const element = document.createElement(tag);
				element.className = className;
				element.textContent = text;
				return element;
			}

			function createSearchResult(post: SearchPost) {
				const link = document.createElement('a');
				link.href = `/blog/${encodeURIComponent(post.slug)}/`;
				link.className = 'block no-underline group';

				const card = document.createElement('article');
				card.className =
					'p-6 bg-white/40 dark:bg-[#151515]/40 backdrop-blur-xl border border-gray-200/50 dark:border-white/10 rounded-none hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300';

				card.append(
					createTextElement(
						'div',
						'text-xs font-bold text-brand dark:text-brand-dark font-sans uppercase tracking-widest mb-2',
						post.category || 'Analysis',
					),
					createTextElement(
						'h2',
						'text-xl font-bold font-sans text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors mb-2',
						post.title,
					),
					createTextElement(
						'p',
						'text-gray-600 dark:text-gray-400 font-serif line-clamp-2 mb-3',
						post.description,
					),
					createTextElement(
						'div',
						'text-sm text-gray-500 font-sans',
						`${post.author} · ${formatDate(post.pubDate)}`,
					),
				);

				link.append(card);
				return link;
			}

			function performSearch(query: string) {
				const results = document.getElementById('search-results');
				const empty = document.getElementById('search-empty');
				const initial = document.getElementById('search-initial');
				if (!results || !empty || !initial) return;

				if (!query.trim()) {
					results.replaceChildren();
					empty.classList.add('hidden');
					initial.classList.remove('hidden');
					return;
				}

				initial.classList.add('hidden');
				const normalizedQuery = query.trim().toLocaleLowerCase();
				const matches = searchData.filter(
					(post) =>
						post.title.toLocaleLowerCase().includes(normalizedQuery) ||
						post.description.toLocaleLowerCase().includes(normalizedQuery) ||
						post.category.toLocaleLowerCase().includes(normalizedQuery) ||
						post.tags.some((tag) => tag.toLocaleLowerCase().includes(normalizedQuery)),
				);

				results.replaceChildren(...matches.map(createSearchResult));
				empty.classList.toggle('hidden', matches.length > 0);
			}

			async function setupSearch() {
				const input = document.getElementById('search-input') as HTMLInputElement | null;
				if (!input) return;

				searchData = await loadSearchIndex();
				input.oninput = () => {
					window.clearTimeout(debounceTimer);
					debounceTimer = window.setTimeout(() => performSearch(input.value), 200);
				};

				const query = new URLSearchParams(window.location.search).get('q') ?? '';
				input.value = query;
				performSearch(query);
			}

			void setupSearch();
			if (!searchWindow.__searchPageLoadBound) {
				document.addEventListener('astro:page-load', () => void setupSearch());
				searchWindow.__searchPageLoadBound = true;
			}
		</script>
	</body>
</html>
