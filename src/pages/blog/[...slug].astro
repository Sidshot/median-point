---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { YouTube } from '@astro-community/astro-embed-youtube';

// Social Embeds
import TweetEmbed from '../../components/embeds/TweetEmbed.astro';
import InstagramEmbed from '../../components/embeds/InstagramEmbed.astro';
import FacebookEmbed from '../../components/embeds/FacebookEmbed.astro';

// Editorial Components
import CalloutBox from '../../components/editorial/CalloutBox.astro';
import TextSize from '../../components/editorial/TextSize.astro';
import Highlight from '../../components/editorial/Highlight.astro';
import StyledDivider from '../../components/editorial/StyledDivider.astro';
import PullQuote from '../../components/editorial/PullQuote.astro';
import ImageCaption from '../../components/editorial/ImageCaption.astro';
import InfoBox from '../../components/editorial/InfoBox.astro';
import RelatedReading from '../../components/editorial/RelatedReading.astro';
import Topline from '../../components/editorial/Topline.astro';

// Phase 2, 3, 4: Advanced Components
import Columns from '../../components/editorial/Columns.astro';
import Accordion from '../../components/editorial/Accordion.astro';
import Timeline from '../../components/editorial/Timeline.astro';
import DropCap from '../../components/editorial/DropCap.astro';
import CustomHeading from '../../components/editorial/CustomHeading.astro';
import ActionBtn from '../../components/editorial/ActionBtn.astro';
import MapEmbed from '../../components/editorial/MapEmbed.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = getPublishedPosts(await getCollection('blog'));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BlogPost {...post.data} id={post.id} headings={headings} readingTime={readingTime}>
	<Content components={{
		YouTube,
		Tweet: TweetEmbed,
		Instagram: InstagramEmbed,
		Facebook: FacebookEmbed,
		Callout: CalloutBox,
		TextSize,
		Highlight,
		Divider: StyledDivider,
		PullQuote,
		ImageCaption,
		InfoBox,
		RelatedReading,
		Topline,
		Columns,
		Accordion,
		Timeline,
		DropCap,
		CustomHeading,
		ActionBtn,
		MapEmbed,
	}} />
</BlogPost>
