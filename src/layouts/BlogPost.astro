---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticleRail from '../components/ArticleRail.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LatestArticlesRail from '../components/LatestArticlesRail.astro';
import { getCollection, getEntry } from 'astro:content';
import { getPostSlug, getPublishedPosts } from '../utils/posts';

type Props = CollectionEntry<'blog'>['data'] & {
	id?: string;
	headings?: MarkdownHeading[];
	readingTime?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	coverImage,
	seoTitle,
	seoDescription,
	author,
	category,
	tags,
	headingColor = 'brand',
	id: currentId,
	headings = [],
	readingTime = 1,
} = Astro.props;

const displayImage = coverImage;
const relatedPosts = getPublishedPosts(await getCollection('blog'))
	.filter((post) => getPostSlug(post) !== currentId)
	.slice(0, 6);

const globalSettings = await getEntry('settings', 'global');
const themeClass = globalSettings?.data?.siteTheme || 'theme-default';
---

<html lang="en">
	<head>
		<BaseHead
			title={seoTitle || title}
			description={seoDescription || description}
			image={coverImage || (currentId ? `/og/${currentId}.png` : undefined)}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={updatedDate ? updatedDate.toISOString() : undefined}
			author={author || 'Sudhanshu Verma'}
			section={category || 'Analysis'}
			tags={tags}
		/>
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "NewsArticle",
			"headline": seoTitle || title,
			"description": seoDescription || description,
			"image": coverImage
				? [new URL(coverImage, Astro.site).toString()]
				: currentId
					? [new URL(`/og/${currentId}.png`, Astro.site).toString()]
					: [],
			"datePublished": pubDate.toISOString(),
			"dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
			"author": [{
				"@type": "Person",
				"name": author || "Sudhanshu Verma",
				"url": new URL("/about", Astro.site).toString()
			}],
			"publisher": {
				"@type": "Organization",
				"name": "Median Point",
				"url": Astro.site?.toString(),
				"logo": {
					"@type": "ImageObject",
					"url": new URL("/favicon.svg", Astro.site).toString()
				}
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": new URL(Astro.url.pathname, Astro.site).toString()
			},
			"articleSection": category || "Analysis",
			"keywords": tags ? tags.join(", ") : undefined,
			"inLanguage": "en-US"
		})} />
	</head>

	<body class="flex flex-col min-h-screen bg-bg dark:bg-bg-dark relative">
		<div class="noise-overlay"></div>
		<Header />

		<article id="article-content" class={themeClass}>
			<!-- Full Bleed Hero Section -->
			<div class="w-full border-b border-gray-100 dark:border-gray-800 pb-0">
				<div class="max-w-4xl mx-auto px-4 pt-16 pb-8 text-center flex flex-col items-center">
					{category && (
						<div class="mb-6">
							<a href={`/archive?category=${encodeURIComponent(category)}`} class="inline-block text-xs font-bold uppercase tracking-widest text-brand dark:text-brand-dark hover:underline">
								{category}
							</a>
						</div>
					)}
					
					<h1 class={`text-4xl md:text-5xl lg:text-6xl font-black mb-8 leading-tight tracking-tight max-w-4xl ${headingColor === 'brand' ? 'text-brand dark:text-brand-dark' : 'text-gray-900 dark:text-gray-100'}`}>
						{title}
					</h1>

					<div class="flex items-center mt-4 text-left">
						<img src="/sudhanshu.png" alt={author || 'Sudhanshu Verma'} class="w-14 h-14 rounded-full object-cover mr-4 border border-gray-200 dark:border-gray-800" />
						<div class="flex flex-col">
							<span class="font-bold text-gray-900 dark:text-gray-100 text-sm">{author || 'Sudhanshu Verma'}</span>
							<div class="flex items-center text-sm text-gray-500 font-sans space-x-2 mt-0.5">
								<FormattedDate date={pubDate} />
								<span>·</span>
								<span id="reading-time-display">{readingTime} min read</span>
								{updatedDate && (
									<>
										<span class="hidden sm:inline">·</span>
										<span class="hidden sm:inline italic">Updated <FormattedDate date={updatedDate} /></span>
									</>
								)}
							</div>
						</div>
					</div>
				</div>

				{displayImage && (
					<div class="w-full max-w-5xl mx-auto mt-10 mb-2 rounded-none overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800">
						<img class="w-full h-auto object-cover max-h-[600px]" src={displayImage} alt={title} />
					</div>
				)}
			</div>

			<main class="flex-grow max-w-[1400px] mx-auto px-4 py-12 w-full">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
					
					<!-- Left Sidebar: Article Navigation (TOC) -->
					<aside class="article-rail-aside hidden lg:block lg:col-span-3 xl:col-span-3 no-print">
						<ArticleRail headings={headings} />
					</aside>

					<!-- Main Content Column -->
					<div class="lg:col-span-9 xl:col-span-6 w-full max-w-[720px] mx-auto">
						
						<div class={`prose dark:prose-invert prose-lg md:prose-xl max-w-none font-serif leading-relaxed text-justify text-gray-800 dark:text-gray-200 prose-img:shadow-2xl prose-img:rounded-none ${headingColor === 'brand' ? 'prose-headings:text-brand dark:prose-headings:text-brand-dark' : ''}`}>
							<slot />
						</div>

						{tags && tags.length > 0 && (
							<div class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-800">
								<div class="flex flex-wrap gap-2">
									{tags.map(tag => (
										<a href={`/archive?tag=${encodeURIComponent(tag)}`} class="bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:bg-brand hover:text-white dark:hover:bg-brand-dark dark:hover:text-white text-xs font-sans font-bold uppercase tracking-wide px-3 py-1 rounded-full transition-colors no-underline">
											#{tag}
										</a>
									))}
								</div>
							</div>
						)}

						<!-- Author & Share Section -->
						<div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between no-print">
							<div class="flex items-center space-x-3 mb-4 sm:mb-0">
								<img src="/sudhanshu.png" alt={author || 'Sudhanshu Verma'} class="w-12 h-12 rounded-full object-cover border-2 border-gray-100 dark:border-gray-800" />
								<div>
									<div class="font-bold text-sm text-gray-900 dark:text-gray-100">{author || 'Sudhanshu Verma'}</div>
									<div class="text-xs text-gray-500 font-sans">Geopolitical Analyst · India & Military Affairs</div>
								</div>
							</div>
							
							<div class="flex items-center space-x-3">
								<span class="text-sm text-gray-500 font-sans font-medium uppercase tracking-wider mr-2">Share</span>
								<button type="button" data-share="twitter" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-400 transition-colors" aria-label="Share on X">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
								</button>
								<button type="button" data-share="linkedin" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-400 transition-colors" aria-label="Share on LinkedIn">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
								</button>
								<!-- Copy Link Button (Item 18) -->
								<button id="copy-link-btn" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-400 transition-colors relative" aria-label="Copy link">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
									<span id="copy-toast" role="status" aria-live="polite" class="absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-xs font-sans font-bold px-2 py-1 rounded opacity-0 pointer-events-none transition-opacity whitespace-nowrap">Copied!</span>
								</button>
								<button id="print-article-btn" type="button" class="p-2 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-400 transition-colors" aria-label="Print article">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2h-6a2 2 0 00-2 2v4h10z"></path></svg>
								</button>
							</div>
						</div>

						<!-- Follow on Google News -->
						<div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-800 no-print">
							<a href="https://www.google.com/preferences/source?q=median-point.vercel.app" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 px-5 py-4 bg-gray-50 dark:bg-[#151515] border border-gray-100 dark:border-gray-800 rounded-xl hover:border-brand/30 dark:hover:border-brand-dark/30 hover:shadow-sm transition-all no-underline group">
								<svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
									<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
									<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
									<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
								</svg>
								<div>
									<div class="text-sm font-bold text-gray-900 dark:text-gray-100 font-sans group-hover:text-brand dark:group-hover:text-brand-dark transition-colors">Follow Median Point on Google News</div>
									<div class="text-xs text-gray-500 font-sans mt-0.5">Stay updated with our latest analysis</div>
								</div>
								<svg class="w-4 h-4 ml-auto text-gray-400 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg>
							</a>
						</div>

						<!-- End-of-Article Suggestions -->
						<section class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-800">
							<h3 class="text-2xl font-bold mb-8 font-sans flex items-center">
								<span class="bg-brand dark:bg-brand-dark w-1.5 h-6 mr-3 block rounded-sm"></span>
								Read Next
							</h3>
							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
								{relatedPosts.slice(0, 6).map(post => (
									<a href={`/blog/${getPostSlug(post)}/`} class="block no-underline group">
										<div class="p-5 bg-gray-50 dark:bg-gray-900/50 rounded-xl border border-gray-100 dark:border-gray-800 hover:border-brand/30 dark:hover:border-brand-dark/30 transition-all hover:-translate-y-0.5 h-full flex flex-col">
											<div class="text-xs font-bold text-brand dark:text-brand-dark uppercase tracking-widest mb-2 font-sans">{post.data.category || 'Analysis'}</div>
											<h4 class="text-base font-bold font-sans text-gray-900 dark:text-gray-100 group-hover:text-brand dark:group-hover:text-brand-dark transition-colors leading-snug mb-2 flex-grow">{post.data.title}</h4>
											<p class="text-sm text-gray-500 dark:text-gray-400 font-serif line-clamp-2 mb-3">{post.data.description}</p>
											<div class="text-xs text-gray-500 font-sans mt-auto"><FormattedDate date={post.data.pubDate} /></div>
										</div>
									</a>
								))}
							</div>
						</section>
					</div> <!-- End Main Content Column -->

					<!-- Right Sidebar: Latest Articles -->
					<div class="hidden xl:block xl:col-span-3">
						<div class="sticky top-24">
							<LatestArticlesRail posts={relatedPosts} />
						</div>
					</div>
				</div>
			</main>

			<!-- Mobile TOC Floating Button -->
			{headings.length > 0 && (
				<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 lg:hidden no-print">
					<button id="mobile-toc-btn" aria-label="Open Table of Contents" class="flex items-center gap-2 px-5 py-3 bg-gray-900/95 dark:bg-gray-100/95 backdrop-blur text-white dark:text-gray-900 rounded-full shadow-2xl hover:-translate-y-1 transition-all">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"></path></svg>
						<span class="font-sans font-bold text-sm tracking-wide">Outline</span>
					</button>
				</div>
				
				<!-- Mobile TOC Modal -->
				<div id="mobile-toc-modal" class="fixed inset-0 z-50 hidden no-print" aria-modal="true" role="dialog">
					<!-- Backdrop -->
					<div id="mobile-toc-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity opacity-0"></div>
					<!-- Bottom Sheet -->
					<div id="mobile-toc-sheet" class="absolute bottom-0 left-0 right-0 bg-bg dark:bg-bg-dark rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.1)] transition-transform translate-y-full max-h-[85vh] flex flex-col">
						<div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center sticky top-0 bg-bg/90 dark:bg-bg-dark/90 backdrop-blur z-10 rounded-t-3xl">
							<h3 class="font-sans font-black text-xl">Article Outline</h3>
							<button id="mobile-toc-close" class="p-2 bg-gray-200 dark:bg-gray-800 rounded-full text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors" aria-label="Close Outline">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
							</button>
						</div>
						<div class="p-6 overflow-y-auto overscroll-contain">
							<ArticleRail headings={headings} />
						</div>
					</div>
				</div>
			)}
		</article>
		<Footer />

		<style>
			:global(#article-content .prose :is(h2, h3, h4)) {
				scroll-margin-top: 6.5rem;
			}

			@media print {
				.article-rail-aside {
					display: none !important;
				}
			}
		</style>

		<script>
			type ArticleActionsWindow = Window & {
				__articleActionsPageLoadBound?: boolean;
				__articleEffectsCleanup?: () => void;
			};

			function openShareWindow(url: string) {
				const popup = window.open(url, '_blank', 'noopener,noreferrer,width=720,height=620');
				if (popup) popup.opener = null;
			}

			async function copyCurrentUrl() {
				try {
					await navigator.clipboard.writeText(window.location.href);
				} catch {
					window.prompt('Copy this link:', window.location.href);
				}

				const toast = document.getElementById('copy-toast');
				if (!toast) return;

				toast.classList.remove('opacity-0');
				toast.classList.add('opacity-100');
				window.setTimeout(() => {
					toast.classList.remove('opacity-100');
					toast.classList.add('opacity-0');
				}, 1500);
			}

			function setupMobileTOC() {
				const btn = document.getElementById('mobile-toc-btn');
				const closeBtn = document.getElementById('mobile-toc-close');
				const modal = document.getElementById('mobile-toc-modal');
				const backdrop = document.getElementById('mobile-toc-backdrop');
				const sheet = document.getElementById('mobile-toc-sheet');

				if (!btn || !modal || !backdrop || !sheet) return;

				const modalEl = modal;
				const backdropEl = backdrop;
				const sheetEl = sheet;

				function openModal() {
					modalEl.classList.remove('hidden');
					// Small delay to allow display block to apply before animating
					setTimeout(() => {
						backdropEl.classList.remove('opacity-0');
						sheetEl.classList.remove('translate-y-full');
					}, 10);
					document.body.style.overflow = 'hidden';
				}

				function closeModal() {
					backdropEl.classList.add('opacity-0');
					sheetEl.classList.add('translate-y-full');
					setTimeout(() => {
						modalEl.classList.add('hidden');
						document.body.style.overflow = '';
					}, 300); // Wait for transition
				}

				btn.addEventListener('click', openModal);
				closeBtn?.addEventListener('click', closeModal);
				backdrop.addEventListener('click', closeModal);

				// Also close modal when a link inside it is clicked
				const links = sheet.querySelectorAll('a');
				links.forEach(link => {
					link.addEventListener('click', closeModal);
				});
			}

			// Initialize on first load and after view transitions
			document.addEventListener('astro:page-load', setupMobileTOC);

			function setupArticleActions() {
				const twitter = document.querySelector<HTMLButtonElement>('[data-share="twitter"]');
				const linkedin = document.querySelector<HTMLButtonElement>('[data-share="linkedin"]');
				const copy = document.getElementById('copy-link-btn');
				const print = document.getElementById('print-article-btn');

				if (twitter) {
					twitter.onclick = () => {
						const params = new URLSearchParams({
							text: document.title,
							url: window.location.href,
						});
						openShareWindow(`https://twitter.com/intent/tweet?${params}`);
					};
				}

				if (linkedin) {
					linkedin.onclick = () => {
						const params = new URLSearchParams({ url: window.location.href });
						openShareWindow(`https://www.linkedin.com/sharing/share-offsite/?${params}`);
					};
				}

				if (copy) copy.onclick = copyCurrentUrl;
				if (print) print.onclick = () => window.print();
			}

			const articleActionsWindow = window as ArticleActionsWindow;

			function setupArticleMediaPerformance() {
				const article = document.getElementById('article-content');
				if (!article) return;

				const images = article.querySelectorAll<HTMLImageElement>('.prose img');
				images.forEach((image, index) => {
					if (!image.hasAttribute('loading')) image.loading = index === 0 ? 'eager' : 'lazy';
					image.decoding = 'async';
				});

				const iframes = article.querySelectorAll<HTMLIFrameElement>('.prose iframe, .custom-html-block iframe, .social-embed iframe');
				iframes.forEach((iframe) => {
					if (!iframe.hasAttribute('loading')) iframe.loading = 'lazy';
				});
			}
			
			function setupScrollEffects() {
				articleActionsWindow.__articleEffectsCleanup?.();
				document.querySelectorAll('.reveal-up.is-revealed').forEach((el) => {
					el.classList.remove('reveal-up', 'is-revealed');
				});

				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					articleActionsWindow.__articleEffectsCleanup = undefined;
					return;
				}

				// Reveal Observer
				const observerOptions = {
					root: null,
					rootMargin: '0px 0px -5% 0px',
					threshold: 0.1
				};
				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-revealed');
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const revealElements = document.querySelectorAll('#article-content .prose > p, #article-content .prose > div, #article-content .prose > figure, #article-content .prose > ul, #article-content .prose > blockquote, .article-rail-aside, .latest-articles-aside');
				revealElements.forEach(el => {
					if (el.classList.contains('is-revealed')) return;
					el.classList.add('reveal-up');
					observer.observe(el);
				});

				articleActionsWindow.__articleEffectsCleanup = () => {
					observer.disconnect();
				};
			}

			setupArticleActions();
			setupArticleMediaPerformance();
			setupScrollEffects();

			if (!articleActionsWindow.__articleActionsPageLoadBound) {
				document.addEventListener('astro:page-load', () => {
					setupArticleActions();
					setupArticleMediaPerformance();
					setupScrollEffects();
				});
				articleActionsWindow.__articleActionsPageLoadBound = true;
			}
		</script>
	</body>
</html>
